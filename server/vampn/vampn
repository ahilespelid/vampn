#!/bin/bash
# vampn - всё управление VPN vampn одной программой. Один и тот же файл стоит на обоих серверах
# (/usr/local/sbin/vampn) и сам понимает, где запущен:
#   homeserv  - сторож VPN-сервера, почта, все настройки (/etc/vampn), команды для вас
#   VPN-сервер - самопроверка, ключи и конфиги пользователей AmneziaWG
#
# Команды (запускайте на homeserv):
#   vampn status           состояние сторожа: туннель, Timeweb, смены IP, журнал
#   vampn server           состояние самого VPN-сервера
#   vampn snapshot         настройки VPN-сервера без ключей (только чтение; по ним собран install.sh)
#   vampn list             пользователи ВСЕХ ячеек: имя, ячейка, IP, почта, последнее подключение (одной ячейки: VAMPN_CELL=N vampn list)
#   vampn peers            только чтение: по каждому ключу сервер, IP клиента, рукопожатие, принято и отправлено байт (для статистики в приложении)
#   vampn reissue ИМЯ      перевыпустить ключ (старый перестаёт работать), новый уйдёт на почту; пользователь из любой ячейки
#   vampn resend ИМЯ       отправить текущий ключ на почту ещё раз (из любой ячейки)
#   vampn resendall       отправить текущий ключ ВСЕМ из users.conf (всех ячеек) заново (с повтором неушедших и тревогой в Telegram)
#   vampn mailstatus       кому и когда ушёл ключ (по всем ячейкам), у кого отправка не удалась
#   vampn mailkey N        прописать на homeserv ключ почты сервера ячейки N (лечит «relay failed ... Permission denied» у resend)
#   vampn keyconf ИМЯ      показать .conf ключа (из него приложение строит QR); пользователь из любой ячейки
#   vampn link ИМЯ         показать строку vpn:// пользователя (из любой ячейки)
#   vampn users            применить /etc/vampn/users.conf сейчас во всех ячейках (сам применяется в течение минуты)
#   vampn rotate [--force] [1|2] сменить IP сервера сейчас, на активном или на указанном (1 основной, 2 запасной); --force - без резерва и пауз по лимиту
#   vampn use 1|2          сделать активным основной (1) или запасной (2) сервер Timeweb и направить туннель на него
#   vampn reboot [hard]    перезагрузить VPN-сервер через API Timeweb
#   vampn sync             подтянуть текущий IP из Timeweb в туннель
#   vampn mirror           скопировать данные пользователей со всех VPN-серверов сейчас
#   vampn deploy           отправить этот скрипт на Бостон и активный VPN-сервер заново (сам отправляется, когда скрипт изменился)
#   vampn cells            ячейки: номер, имя, IP, пользователей/лимит, рукопожатие, состояние (таблица через табуляцию)
#   vampn account add ИМЯ  добавить кабинет Timeweb (токен на stdin); account list|default|del
#   vampn spawn [КАБИНЕТ]  арендовать сервер vampn_N (Timeweb, Амстердам, самый дешёвый, Debian) и развернуть ячейку; ход: vampn spawnstatus
#   (spawn сам удаляет нерабочий сервер и ячейку, если развёртывание упало, и берёт новый сервер - до 5 попыток)
#   vampn spawnresume N   продолжить развёртывание на уже созданном сервере ячейки N (если spawn упал, а сервер остался)
#   vampn celldel N --yes удалить ячейку и её сервер
#   vampn init [--user ИМЯ] [--net 10.77.4] [--port N] [--public-ip IP]
#                         на новом чистом Debian 13 из клона репозитория (bash server/vampn/vampn init): поставить пакеты, AmneziaWG, файрвол,
#                         самолечение и поднять рабочую ячейку без homeserv; в конце печатает конфиг, QR и ссылку первого пользователя.
#                         --packages-only - только пакеты и утилиты awg
#   vampn add ИМЯ [почта] / del ИМЯ   (на таком сервере) завести / удалить пользователя; list, conf, qr, link, status - как везде
#   vampn adopt IP [--hours Ч] [--no-rescue]
#                         (homeserv) сервер, поднятый командой vampn init, становится ячейкой, а всех «отвалившихся» из ВСЕХ ячеек
#                         (нет рукопожатия дольше Ч часов, по умолчанию 1, или ячейка не отвечает) переносит в неё и рассылает им новые ключи
#   vampn rescue N [--hours Ч] [--dry]   то же самое переносом в уже существующую ячейку N; --dry - только показать, кого перенесёт
#   vampn installscript   установочный бандл для чистого Debian (install.sh)
#   VAMPN_CELL=N vampn ... любая команда homeserv для ячейки N (status, rotate, users, mirror, resendall ...)
#   vampn emergency on     включить аварийный канал (Бостон): VPN и Telegram через него, ключи на почту
#   vampn emergency off    выключить вручную (сам выключается, когда Timeweb 3 минуты снова отвечает)
#   vampn emergency        состояние аварийного режима
#   vampn mailtest АДРЕС   тестовое письмо
#   vampn help             эта справка
# Настройки (homeserv, /etc/vampn): timeweb.env - токен Timeweb, secrets.env - почта,
#   users.conf - пользователи (ИМЯ ПОЧТА; сохранили - через минуту применено, ключи разосланы).
# Служебные (их вызывают таймер и ключи между серверами): check, userspush, remote, mail,
#   alert, conf, qr, mailsend, endpointchange, selfupdate. Журнал отправки писем: /var/lib/vampn/mail-status.tsv.
set -uo pipefail
SELF=/usr/local/sbin/vampn
# Ячейка = отдельный VPN-сервер со своими ключами, адресом и туннелем (до ~1000 клиентов на ячейку). Ячейка 1 - исходная,
# её состояние и файлы остались прежними. Для остальных: VAMPN_CELL=N vampn ... (так их запускает vampn-cell@N.timer),
# настройки ячейки лежат в /etc/vampn/cells/N.env (CELL_NET - три октета адресов туннеля, CELL_NAME, CELL_LIMIT).
CELL=${VAMPN_CELL:-1}
[[ $CELL =~ ^[0-9]{1,3}$ ]] && (( CELL >= 1 )) || { echo "vampn: плохой номер ячейки '$CELL'" >&2; exit 1; }
STATE=/var/lib/vampn
TUN_NET=10.77.0 TUN_IFACE=vampn CELL_NAME=vampn CELL_LIMIT=1000
if (( CELL > 1 )); then
  CELL_ENV=${VAMPN_ETC:-/etc/vampn}/cells/$CELL.env
  [[ -f $CELL_ENV ]] || { echo "vampn: нет ячейки $CELL ($CELL_ENV)" >&2; exit 1; }
  # shellcheck disable=SC1090
  . "$CELL_ENV"
  TUN_NET=${CELL_NET:?нет CELL_NET в $CELL_ENV}; TUN_IFACE=vampn$CELL; STATE=${VAMPN_CELLS_STATE:-/var/lib/vampn/cells}/$CELL
fi
SRV_TIP=$TUN_NET.1 HOME_TIP=$TUN_NET.3   # адреса сервера и homeserv внутри туннеля этой ячейки
mkdir -p "$STATE"; chmod 700 "$STATE"
AWG_DIR=${VAMPN_AWG_DIR:-/etc/amnezia/amneziawg}
if   [[ -f ${VAMPN_ETC:-/etc/vampn}/role ]];     then ROLE=$(< "${VAMPN_ETC:-/etc/vampn}/role")   # emergency - Бостон
elif [[ -f $AWG_DIR/awg0.conf ]];                then ROLE=server
elif [[ -f $AWG_DIR/$TUN_IFACE.conf ]];          then ROLE=home
elif [[ ${1:-} == init ]];                      then ROLE=new   # чистый сервер: init ставит пакеты ещё до настройки
else echo "vampn: не понял, где запущен (нет конфига AmneziaWG)" >&2; exit 1; fi

now() { date +%s; }
get() { cat "$STATE/$1" 2>/dev/null || echo "${2:-0}"; }
put() { echo "$2" > "$STATE/$1"; }
die() { echo "vampn: $*" >&2; exit 1; }
valid_name() { [[ $1 =~ ^[a-zA-Z0-9_.-]{1,32}$ ]] || die "плохое имя '$1' (латиница, цифры, _ . -)"; }
valid_email() { [[ -z $1 || $1 =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] || die "плохая почта '$1'"; }
ROTATION_REASON="Адрес VPN-сервера изменился, старый ключ больше не работает."

# ====================================================================================================
# Почта (Python внутри). Письма пользователям: текст + строка vpn:// + .conf + QR.
# MAIL_METHOD=smtp - отправка через SMTP (homeserv); relay - передать письмо homeserv по туннелю
# (VPN-сервер: Timeweb закрывает там порты почты).
# ====================================================================================================
read -r -d '' MAIL_PY <<'PY' || true
import email.utils, os, re, smtplib, ssl, subprocess, sys, time
from email import policy
from email.message import EmailMessage
from email.parser import BytesParser

SELF = os.environ['VAMPN_SELF']
BASE = os.environ.get('VAMPN_BASE', '/root/vampn')
CL = BASE + '/clients'
STATE_DIR = os.environ.get('VAMPN_STATE', '/var/lib/vampn')
MAIL_LOG = STATE_DIR + '/mail-status.tsv'   # журнал отправки: время, имя, адрес, вид (key|notice), ok|fail, подробности
SENT_DIR = '/var/lib/vampn/mail-sent'   # письма о смене IP: файл на адрес, строки - кому уже ушло
ROTATION_REASON = 'Адрес VPN-сервера изменился, старый ключ больше не работает.'
KIND = os.environ.get('VAMPN_KIND', '')     # emergency - ключи аварийного сервера


def profile(name):
    return f'vampn-{name}-emergency' if KIND == 'emergency' else f'vampn-{name}'


def load_env(path):
    env = {}
    try:
        f = open(path, encoding='utf-8')
    except FileNotFoundError:
        return env
    with f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#') or '=' not in line:
                continue
            k, v = line.split('=', 1)
            v = v.split('  #')[0].split('\t#')[0].strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in '"\'':
                v = v[1:-1]
            env[k.strip()] = v
    return env


S = load_env('/etc/vampn/secrets.env')
HOME_TIP = load_env(BASE + '/server.env').get('SUBNET', '10.77.0') + '.3'   # homeserv внутри туннеля этого сервера


def _smtp_once(m):
    host, port = S['SMTP_HOST'], int(S.get('SMTP_PORT', '587'))
    mode = S.get('SMTP_TLS', 'starttls').split()[0].lower()
    ctx = ssl.create_default_context()
    if mode == 'ssl':
        c = smtplib.SMTP_SSL(host, port, context=ctx, timeout=30)
    else:
        c = smtplib.SMTP(host, port, timeout=30)
        c.ehlo()
        if mode == 'starttls':
            c.starttls(context=ctx)
            c.ehlo()
    with c:
        if S.get('SMTP_USER'):
            c.login(S['SMTP_USER'], S['SMTP_PASS'])
        c.send_message(m)


SMTP_PERMANENT = (smtplib.SMTPAuthenticationError, smtplib.SMTPRecipientsRefused, smtplib.SMTPSenderRefused)


def smtp_send(m, tries=3):
    """Отправка с повторами: сбой сети или временный отказ - ещё раз через 5 и 20 с. Неверный пароль или адрес повторять бесполезно."""
    last = None
    for i in range(tries):
        try:
            return _smtp_once(m)
        except SMTP_PERMANENT:
            raise
        except (smtplib.SMTPException, OSError) as e:
            last = e
            if i < tries - 1:
                time.sleep(5 * 4 ** i)
    raise last


def journal(m, status, detail=''):
    """Строка в журнал отправки (его читают vampn mailstatus и сторож). Сбой записи письму не мешает."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        to = email.utils.getaddresses([str(m['To'] or '')])
        addr = to[0][1] if to else ''
        user = str(m.get('X-Vampn-User') or '')
        det = re.sub(r'\s+', ' ', str(detail))[:200]
        with open(MAIL_LOG, 'a', encoding='utf-8') as f:
            f.write('\t'.join([str(int(time.time())), user, addr, 'key' if user else 'notice', status, det]) + '\n')
        if os.path.getsize(MAIL_LOG) > 400000:
            with open(MAIL_LOG, encoding='utf-8') as f:
                tail = f.read().splitlines()[-1500:]
            with open(MAIL_LOG, 'w', encoding='utf-8') as f:
                f.write('\n'.join(tail) + '\n')
    except OSError:
        pass


def smtp_deliver(m):
    """Отправить письмо и записать итог в журнал: ok - SMTP-сервер принял письмо, fail - не удалось после повторов."""
    try:
        smtp_send(m)
    except Exception as e:
        journal(m, 'fail', f'{e.__class__.__name__}: {e}')
        raise
    journal(m, 'ok')


def already_sent(m):
    user, ep = m.get('X-Vampn-User'), m.get('X-Vampn-Endpoint')
    if not (user and ep and m.get('X-Vampn-Rotation')):
        return False
    try:
        return user in open(f'{SENT_DIR}/{ep}').read().split()
    except FileNotFoundError:
        return False


def mark_sent(m):
    user, ep = m.get('X-Vampn-User'), m.get('X-Vampn-Endpoint')
    if user and ep and m.get('X-Vampn-Rotation'):
        os.makedirs(SENT_DIR, exist_ok=True)
        with open(f'{SENT_DIR}/{ep}', 'a') as f:
            f.write(user + '\n')


# Приложение vampn (API на homeserv): о каждом письме с ключом ему пишется ключ (keys) и уведомление (notifications).
APP_DB = ['docker', 'exec', '-i', 'vampn_percona', 'sh', '-c',
          'MYSQL_PWD="$MYSQL_PASSWORD" mysql -u"$MYSQL_USER" "$MYSQL_DATABASE" --default-character-set=utf8mb4 -B -N']
APP_TITLES = {'rotation': 'Новый ключ VPN: сменился адрес сервера', 'reissued': 'Новый ключ VPN',
              'emergency': 'Аварийный ключ VPN', 'plain': 'Ключ VPN отправлен на почту'}


def app_kind(m):
    """Вид письма с ключом: rotation (смена IP), reissued (перевыпуск), emergency, plain (первая отправка или повтор).
    На homeserv письмо приходит от VPN-сервера по ретрансляции без VAMPN_KIND, поэтому аварийный ключ узнаётся и по теме."""
    subject = str(m.get('Subject', ''))
    if KIND == 'emergency' or subject.startswith('Ваш VPN: аварийный ключ'):
        return 'emergency'
    if m.get('X-Vampn-Rotation'):
        return 'rotation'
    if subject.startswith('Ваш VPN: новый ключ'):
        return 'reissued'
    return 'plain'


def app_sql(name, kind):
    """SQL для приложения. Имя уже проверено регулярным выражением, заголовки - константы из APP_TITLES."""
    if kind == 'plain':
        first = ("SET @first = (SELECT COUNT(*) = 0 FROM `keys` k JOIN users u ON u.id = k.user_id "
                 f"WHERE u.name = '{name}');\n")
        reason = "IF(@first, 'created', 'resent')"
    else:
        first, reason = '', "'reissued'"
    # время в UTC, как у API (там init_command SET time_zone='+00:00'): иначе отметки разойдутся с часовым поясом сервера
    return ("SET time_zone = '+00:00';\n" + 'START TRANSACTION;\n' + first +
            'INSERT INTO `keys` (user_id, key_name, reason, issued_by, issued_at) '
            f"SELECT u.id, u.name, {reason}, 'vampn', UTC_TIMESTAMP() FROM users u WHERE u.name = '{name}' AND u.active = 1;\n"
            'INSERT INTO notifications (user_id, key_id, kind, title, email_sent_at, created_at) '
            f"SELECT k.user_id, k.id, 'key', '{APP_TITLES[kind]}', UTC_TIMESTAMP(), UTC_TIMESTAMP() "
            'FROM `keys` k WHERE k.id = LAST_INSERT_ID();\n'
            'COMMIT;\n')


def notify_app(m):
    """Сообщить приложению о письме с ключом. Письмо уже ушло, поэтому любой сбой (нет базы, нет docker) молча пропускается."""
    name = str(m.get('X-Vampn-User') or '')
    if not re.fullmatch(r'[A-Za-z0-9._-]{1,32}', name):
        return
    try:
        subprocess.run(APP_DB, input=app_sql(name, app_kind(m)).encode(), stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except Exception:
        pass


def relay_fresh():
    """Сервер пишет на homeserv только пока homeserv сам держит с ним туннель. У основного и запасного одни ключи:
    первое же письмо с неактивного сервера утащило бы туннель homeserv на него (пир «переезжает» на того, кто написал)."""
    try:
        ak = subprocess.run(['awg', 'show', 'awg0', 'allowed-ips'], capture_output=True, text=True, timeout=5).stdout
        pk = next((l.split()[0] for l in ak.splitlines() if HOME_TIP + '/32' in l.split()[1:]), None)
        if not pk:
            return True    # это не VPN-сервер или homeserv у него не пир - не мешаем
        hs = subprocess.run(['awg', 'show', 'awg0', 'latest-handshakes'], capture_output=True, text=True, timeout=5).stdout
        t = next((int(l.split()[1]) for l in hs.splitlines() if l.split() and l.split()[0] == pk), 0)
        return time.time() - t < 240
    except Exception:
        return True


def deliver(m):
    """Отправить одно письмо. Возвращает 'sent' или 'dup'."""
    if S.get('MAIL_METHOD', 'smtp').lower() == 'relay' and not relay_fresh():
        if not S.get('SMTP_HOST'):
            raise RuntimeError('relay skipped: homeserv сейчас не держит туннель с этим сервером')
    elif S.get('MAIL_METHOD', 'smtp').lower() == 'relay':
        r = subprocess.run(
            ['ssh', '-i', '/root/.ssh/mailrelay', '-p', S.get('RELAY_PORT', '777'),
             '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', '-o', 'IdentitiesOnly=yes', '-o', 'LogLevel=ERROR',
             '-o', 'StrictHostKeyChecking=accept-new', '-o', 'UserKnownHostsFile=/root/.ssh/mailrelay.known_hosts',
             'root@' + S.get('RELAY_HOST', HOME_TIP)],
            input=m.as_bytes(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
        out = r.stdout.decode(errors='replace').strip()
        if r.returncode == 0:
            return 'dup' if out == 'dup' else 'sent'
        if not S.get('SMTP_HOST'):
            raise RuntimeError(f'relay failed: {r.stderr.decode(errors="replace").strip()[-300:]}')
        # homeserv недоступен - пробуем SMTP напрямую (сработает, если хостер открыл порты)
    if already_sent(m):
        return 'dup'
    smtp_deliver(m)
    mark_sent(m)
    notify_app(m)
    return 'sent'


def base_msg(to, subject):
    m = EmailMessage()
    if S.get('MAIL_FROM'):
        m['From'] = S['MAIL_FROM']
    m['To'] = to
    m['Subject'] = subject
    m['Date'] = email.utils.formatdate(localtime=True)
    m['Message-ID'] = email.utils.make_msgid()
    return m


def render(name):
    subprocess.run([SELF, 'conf', name], check=True, stdout=subprocess.DEVNULL, env=dict(os.environ, VAMPN_BASE=BASE))


def vpn_link(name):
    """Ключ AmneziaVPN: vpn:// + base64url(qCompress(JSON)) - как экспорт самого приложения."""
    import base64, json, struct, zlib
    u = load_env(f'{CL}/{name}.env')
    sv = load_env(BASE + '/server.env')
    conf = open(f'{CL}/{name}.conf', encoding='utf-8').read()
    host = open(BASE + '/endpoint').read().strip()
    obf = {'Jc': sv['JC'], 'Jmin': sv['JMIN'], 'Jmax': sv['JMAX'], 'S1': sv['S1'], 'S2': sv['S2'],
           'S3': sv['S3'], 'S4': sv['S4'], 'H1': sv['H1'], 'H2': sv['H2'], 'H3': sv['H3'], 'H4': sv['H4'],
           'I1': sv.get('I1', ''), 'I2': '', 'I3': '', 'I4': '', 'I5': ''}
    allowed = [a.strip() for a in u.get('ALLOWED', '0.0.0.0/0, ::/0').split(',')]
    last = dict(obf, config=conf, hostName=host, port=int(sv['PORT']), client_ip=u['IP'],
                client_priv_key=u['PRIVKEY'], client_pub_key=u['PUBKEY'], client_id=u['PUBKEY'],
                server_pub_key=sv['SERVER_PUBKEY'], psk_key=u['PSK'], allowed_ips=allowed,
                persistent_keep_alive='25', mtu=str(sv['MTU']))
    awg = dict(obf, port=str(sv['PORT']), transport_proto='udp', protocol_version='2',
               subnet_address=sv.get('SUBNET', '10.77.0') + '.0', subnet_cidr=sv.get('SUBNET_CIDR', '24'),
               last_config=json.dumps(last, ensure_ascii=False, separators=(',', ':')))
    doc = {'containers': [{'container': 'amnezia-awg2', 'awg': awg}],
           'defaultContainer': 'amnezia-awg2', 'description': profile(name),
           'dns1': '1.1.1.1', 'dns2': '9.9.9.9', 'hostName': host}
    raw = json.dumps(doc, ensure_ascii=False, indent=4).encode()
    packed = struct.pack('>I', len(raw)) + zlib.compress(raw, 8)        # = Qt qCompress(data, 8)
    return 'vpn://' + base64.urlsafe_b64encode(packed).decode().rstrip('=')


def user_msg(name, reason):
    u = load_env(f'{CL}/{name}.env')
    if not u.get('EMAIL'):
        raise ValueError(f'{name}: нет почты')
    render(name)
    conf = open(f'{CL}/{name}.conf', 'rb').read()
    qr = subprocess.run(['qrencode', '-t', 'PNG', '-o', '-', '-s', '6'], input=conf, check=True,
                        stdout=subprocess.PIPE).stdout
    if KIND == 'emergency':
        subject = f'Ваш VPN: аварийный ключ «{name}»'
    else:
        subject = f'Ваш VPN: новый ключ «{name}»' if reason else f'Ваш VPN: ключ «{name}»'
    m = base_msg(u['EMAIL'], subject)
    m['X-Vampn-User'] = name
    ep_ip = open(BASE + '/endpoint').read().strip()
    m['X-Vampn-Endpoint'] = ep_ip
    if reason == ROTATION_REASON:
        m['X-Vampn-Rotation'] = '1'
    intro = f'{reason}\n\n' if reason else ''
    m.set_content(
        f'Здравствуйте!\n\n{intro}'
        f'Имя ключа: {name} (в приложении профиль будет называться {profile(name)})\n'
        f'Адрес сервера (IP): {ep_ip}\n\n'
        'Ваш ключ VPN (скопируйте строку целиком):\n\n'
        f'{vpn_link(name)}\n\n'
        'Как подключиться:\n'
        '1. Установите приложение AmneziaVPN (https://amnezia.org).\n'
        '2. Нажмите «Добавить» -> «Вставить ключ» и вставьте строку vpn:// выше.\n'
        '   Или: «Файл с настройками» -> вложенный файл .conf (подходит и для приложения AmneziaWG),\n'
        '   или отсканируйте вложенный QR-код с телефона.\n'
        '3. Если у вас уже был профиль этого VPN, удалите его и добавьте новый.\n\n'
        'Не пересылайте ключ другим людям: он личный.\n')
    m.add_attachment(conf, maintype='application', subtype='octet-stream', filename=f'{profile(name)}.conf')
    m.add_attachment(qr, maintype='image', subtype='png', filename=f'{profile(name)}-qr.png')
    return m


def main(argv):
    if argv[0] == '--relay':
        raw = sys.stdin.buffer.read(10 * 1024 * 1024)
        m = BytesParser(policy=policy.default).parsebytes(raw)
        if not m['To'] or len(email.utils.getaddresses([m['To']])) != 1:
            print('relay: нужен ровно один получатель', file=sys.stderr)
            return 2
        if S.get('MAIL_FROM'):
            del m['From']
            m['From'] = S['MAIL_FROM']
        if already_sent(m):
            print('dup')
            return 0
        smtp_deliver(m)
        mark_sent(m)
        notify_app(m)
        print('sent')
        return 0
    if argv[0] == '--notice':   # простое письмо всем с почтой: --notice ТЕМА, текст на stdin ({name}, {profile})
        text, subj, fails = sys.stdin.read(), argv[1], 0
        for f in sorted(os.listdir(CL)):
            u = load_env(f'{CL}/{f}') if f.endswith('.env') else {}
            if not u.get('EMAIL'):
                continue
            n = f[:-4]
            m = base_msg(u['EMAIL'], subj.replace('{name}', n))
            m.set_content(text.replace('{name}', n).replace('{profile}', f'vampn-{n}'))
            try:
                print(deliver(m), n)
                time.sleep(1)
            except Exception as e:
                fails += 1
                print('FAIL', n, e, file=sys.stderr)
        return 1 if fails else 0
    if argv[0] == '--link':
        render(argv[1])
        print(vpn_link(argv[1]))
        return 0
    if argv[0] == '--test':
        m = base_msg(argv[1], 'vampn: проверка почты')
        m.set_content(f'Тестовое письмо с {os.uname().nodename}: почта настроена верно.')
        print(deliver(m), argv[1])
        return 0
    if argv[0] == '--alert':
        to = S.get('ALERT_EMAIL') or S.get('SMTP_USER')
        if not to:
            print('нет ALERT_EMAIL', file=sys.stderr)
            return 1
        m = base_msg(to, '[vampn] ' + argv[1])
        m.set_content(sys.stdin.read() or argv[1])
        print(deliver(m))
        return 0
    reason = ''
    if '--reason' in argv:
        i = argv.index('--reason')
        reason = argv[i + 1]
        del argv[i:i + 2]
    if argv[0] == '--all':
        names = sorted(f[:-4] for f in os.listdir(CL)
                       if f.endswith('.env') and load_env(f'{CL}/{f}').get('EMAIL'))
    else:
        names = argv
    # рассылка после смены IP: BASE/mail_pending - кому уже ушло, при повторе их пропускаем
    pend = BASE + '/mail_pending'
    rotation = argv[0] == '--all' and os.path.exists(pend)
    done = set(open(pend).read().split()) if rotation else set()
    fails = 0
    for n in names:
        if n in done:
            continue
        try:
            print(deliver(user_msg(n, reason)), n)
            if rotation:
                with open(pend, 'a') as f:
                    f.write(n + '\n')
            time.sleep(1)
        except Exception as e:
            fails += 1
            print('FAIL', n, e, file=sys.stderr)
    return 1 if fails else 0


sys.exit(main(sys.argv[1:]))
PY
mailpy() { VAMPN_SELF=$SELF VAMPN_BASE=${BASE:-/root/vampn} python3 -c "$MAIL_PY" "$@"; }

# ====================================================================================================
# Данные пользователей: ключи, конфиги AmneziaWG. Каталог $VAMPN_BASE (по умолчанию /root/vampn;
# на homeserv - копия /var/lib/vampn/mirror, по ней собираются конфиги для рассылки после смены IP).
# ====================================================================================================
BASE=${VAMPN_BASE:-/root/vampn}
CL=$BASE/clients
SRV_CONF=/etc/amnezia/amneziawg/awg0.conf

data_init() {
  [[ -f $BASE/server.env ]] || die "нет данных в $BASE"
  # shellcheck disable=SC1091
  source "$BASE/server.env"
  ENDPOINT_IP=$(cat "$BASE/endpoint")
}

next_ip() {  # свободный адрес клиента; SUBNET_SPAN (по умолчанию 1) - сколько подряд идёт /24: у ячейки 4 (/22) это ~1000 клиентов
  local used o n base third span=${SUBNET_SPAN:-1}
  used=$(grep -h '^IP=' "$CL"/*.env 2>/dev/null | cut -d= -f2)
  base=${SUBNET%.*}; third=${SUBNET##*.}
  for (( o = 0; o < span; o++ )); do
    for n in $(seq 2 254); do grep -qx "$base.$((third + o)).$n" <<<"$used" || { echo "$base.$((third + o)).$n"; return; }; done
  done
  die "подсеть заполнена"
}
client_count() { local n=0 f; for f in "$CL"/*.env; do [[ -f $f && $(basename "$f" .env) != homeserv ]] && n=$((n + 1)); done; echo "$n"; }

render() {  # ИМЯ -> $CL/ИМЯ.conf
  local f=$CL/$1.env
  [[ -f $f ]] || die "нет пользователя $1"
  # shellcheck disable=SC1090
  ( source "$f"; umask 077
    cat > "$CL/$1.conf" <<EOF
[Interface]
PrivateKey = $PRIVKEY
Address = $IP/32
DNS = 1.1.1.1, 9.9.9.9
MTU = $MTU
Jc = $JC
Jmin = $JMIN
Jmax = $JMAX
S1 = $S1
S2 = $S2
S3 = $S3
S4 = $S4
H1 = $H1
H2 = $H2
H3 = $H3
H4 = $H4
I1 = $I1

[Peer]
PublicKey = $SERVER_PUBKEY
PresharedKey = $PSK
AllowedIPs = ${ALLOWED:-0.0.0.0/0, ::/0}
Endpoint = $ENDPOINT_IP:$PORT
PersistentKeepalive = 25
EOF
  )
}

sync_server() {  # пиры awg0.conf = файлы пользователей; применяется без разрыва соединений
  local tmp f; tmp=$(mktemp)
  sed '/^\[Peer\]/,$d' "$SRV_CONF" | grep -v '^# [a-zA-Z0-9_.-]*$' | sed '/^$/d' > "$tmp"
  for f in "$CL"/*.env; do
    [[ -f $f ]] || continue
    # shellcheck disable=SC1090
    ( source "$f"
      printf '\n[Peer]\n# %s\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s/32%s\n' \
        "$NAME" "$PUBKEY" "$PSK" "$IP" "${ROUTED:+, $ROUTED}" ) >> "$tmp"
  done
  install -m 600 "$tmp" "$SRV_CONF"; rm -f "$tmp"
  ip link show awg0 &>/dev/null && awg syncconf awg0 <(awg-quick strip awg0)
}

user_add() {  # ИМЯ ПОЧТА
  local name=$1 email=${2:-} sk
  valid_name "$name"; valid_email "$email"
  [[ -f $CL/$name.env ]] && die "пользователь $name уже есть"
  [[ -z ${CLIENT_LIMIT:-} ]] || (( $(client_count) < CLIENT_LIMIT )) || die "сервер заполнен: уже $CLIENT_LIMIT клиентов"
  sk=$(awg genkey)
  ( umask 077; cat > "$CL/$name.env" <<EOF
NAME=$name
EMAIL=$email
IP=$(next_ip)
PRIVKEY=$sk
PUBKEY=$(echo "$sk" | awg pubkey)
PSK=$(awg genpsk)
CREATED=$(date -Iseconds)
EOF
  )
  render "$name"; sync_server
  [[ -z $email ]] || mailpy "$name"
}

user_del() { valid_name "$1"; rm -f "$CL/$1.env" "$CL/$1.conf"; sync_server; }

user_email() {  # ИМЯ ПОЧТА
  local f=$CL/$1.env
  if grep -q '^EMAIL=' "$f"; then sed -i "s|^EMAIL=.*|EMAIL=$2|" "$f"; else echo "EMAIL=$2" >> "$f"; fi
}

user_reissue() {  # ИМЯ - новые ключи, старый ключ перестаёт работать, письмо с новым
  local f=$CL/$1.env sk
  sk=$(awg genkey)
  sed -i -e "s|^PRIVKEY=.*|PRIVKEY=$sk|" -e "s|^PUBKEY=.*|PUBKEY=$(echo "$sk" | awg pubkey)|" \
         -e "s|^PSK=.*|PSK=$(awg genpsk)|" "$f"
  if grep -q '^REISSUED=' "$f"; then sed -i "s|^REISSUED=.*|REISSUED=$(date -Iseconds)|" "$f"
  else echo "REISSUED=$(date -Iseconds)" >> "$f"; fi
  render "$1"; sync_server
  echo "ключ $1 перевыпущен"
  grep -q '^EMAIL=.\+' "$f" && mailpy --reason "Ваш ключ перевыпущен, старый больше не работает." "$1"
}

users_list() {
  local f t
  declare -A hs
  while read -r pk ts; do hs[$pk]=$ts; done < <(awg show awg0 latest-handshakes 2>/dev/null || true)
  echo "ИМЯ                  IP              ПОЧТА                          ПОСЛЕДНЕЕ ПОДКЛЮЧЕНИЕ"
  for f in "$CL"/*.env; do [[ -f $f ]] || continue
    ( source "$f"; t=${hs[$PUBKEY]:-0}
      if [[ $t -gt 0 ]]; then t=$(date -d "@$t" '+%F %T'); else t=никогда; fi
      printf '%-20s %-15s %-30s %s\n' "$NAME" "$IP" "${EMAIL:--}" "$t" )
  done
}

# Только чтение. По строке на ключ, поля через табуляцию: ИМЯ, IP клиента (или -), последнее рукопожатие (unix, 0 - не было),
# принято от клиента и отправлено клиенту байт (счётчики awg, сбрасываются при перезапуске интерфейса).
# Публичные ключи, ключи шифрования и конфиги не выводятся.
users_peers() {
  local f pk e h r t
  declare -A ep hs rx tx
  while IFS=$'\t' read -r pk e h r t; do
    [[ -n $pk ]] || continue
    ep[$pk]=$e; hs[$pk]=$h; rx[$pk]=$r; tx[$pk]=$t
  done < <(awg show awg0 dump 2>/dev/null | awk -F'\t' 'NR>1 && NF>=7 {print $1 "\t" ($3 == "" ? "(none)" : $3) "\t" $5 "\t" $6 "\t" $7}')
  for f in "$CL"/*.env; do [[ -f $f ]] || continue
    ( source "$f"
      e=${ep[$PUBKEY]:-}
      if [[ $e == \[* ]]; then e=${e#\[}; e=${e%%\]*}; else e=${e%:*}; fi   # адрес без порта, IPv6 в скобках тоже
      [[ -z $e || $e == '(none)' ]] && e=-
      h=${hs[$PUBKEY]:-0}; [[ $h =~ ^[0-9]+$ ]] || h=0
      r=${rx[$PUBKEY]:-0}; [[ $r =~ ^[0-9]+$ ]] || r=0
      t=${tx[$PUBKEY]:-0}; [[ $t =~ ^[0-9]+$ ]] || t=0
      printf '%s\t%s\t%s\t%s\t%s\n' "$NAME" "$e" "$h" "$r" "$t" )
  done
}

endpoint_change() {  # IP - новый адрес во все конфиги и рассылка ключей
  local ip=$1 f
  [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "плохой IP $ip"
  [[ $ip == "$ENDPOINT_IP" ]] && { echo "адрес уже $ip"; return 0; }
  echo "$ip" > "$BASE/endpoint"; ENDPOINT_IP=$ip
  for f in "$CL"/*.env; do [[ -f $f ]] && render "$(basename "$f" .env)"; done
  echo "$(date -Iseconds) endpoint -> $ip" >> "$BASE/rotation.log"
  : > "$BASE/mail_pending"
  mailpy --all --reason "$ROTATION_REASON" && rm -f "$BASE/mail_pending"
}

sync_users() {  # привести пользователей к /etc/vampn/users.conf (на сервере - копия с homeserv)
  local USERS=/etc/vampn/users.conf PROTECTED=" homeserv " bad=0 n e extra cur f
  [[ -f $USERS ]] || die "нет $USERS"
  declare -A want
  while read -r n e extra; do
    [[ -z $n || $n == \#* ]] && continue
    if [[ -n $extra || ! $n =~ ^[a-zA-Z0-9_.-]{1,32}$ || ! $e =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]]; then
      echo "users.conf: пропускаю строку '$n $e $extra' (нужно: имя почта)"; bad=1; continue
    fi
    [[ $PROTECTED == *" $n "* ]] && { echo "users.conf: '$n' - служебное имя, пропускаю"; continue; }
    want[$n]=$e
  done < <(sed 's/\r$//' "$USERS")
  for n in "${!want[@]}"; do
    if [[ ! -f $CL/$n.env ]]; then
      echo "+ $n ${want[$n]}"; ( user_add "$n" "${want[$n]}" >/dev/null ) || echo "! $n: ошибка добавления/отправки"
    else
      cur=$(grep -m1 '^EMAIL=' "$CL/$n.env" | cut -d= -f2-)
      if [[ $cur != "${want[$n]}" ]]; then
        echo "~ $n: $cur -> ${want[$n]}"; user_email "$n" "${want[$n]}"
        mailpy "$n" >/dev/null || echo "! $n: ошибка отправки"
      fi
    fi
  done
  if (( ${#want[@]} == 0 || bad )); then
    (( ${#want[@]} == 0 )) && echo "users.conf пуст - никого не удаляю"
    (( bad )) && echo "в users.conf есть ошибки - никого не удаляю"
  else
    for f in "$CL"/*.env; do
      [[ -f $f ]] || continue
      n=$(basename "$f" .env)
      [[ $PROTECTED == *" $n "* || -n ${want[$n]:-} ]] && continue
      grep -qx 'LOCAL=1' "$f" && continue      # заведён на самом сервере (vampn add): список homeserv его не трогает
      echo "- $n"; user_del "$n"
    done
  fi
}

# ====================================================================================================
# VPN-сервер: самопроверка раз в минуту
#  - nftables не загружен -> загружает;  awg0 упал, не поднят или не слушает порт VPN -> перезапускает;
#    в фильтре нет правила для порта VPN -> перезагружает nftables;  ip_forward выключен -> включает;  sshd лёг -> запускает
#  - eth0 лёг / нет IPv4 / нет маршрута по умолчанию / networkd не запущен -> поднимает и переподключает сразу
#  - нет интернета: 3 мин -> переподключение eth0, 6 мин -> перезапуск systemd-networkd,
#    10 мин -> перезагрузка (не чаще раза в час, не больше 4 в сутки)
#  - снаружи сервер виден по адресу, которого нет на eth0 (Timeweb не обновил DHCP) -> после трёх проверок подряд
#    адрес закрепляется в /etc/netplan/60-vampn-ip.yaml (запретить: файл /etc/vampn/no-pin); устаревшая закрепка снимается сама
#  - публичный IPv4 сменился -> новые конфиги и рассылка (письма уходят через homeserv, дубли он отсекает)
# ====================================================================================================
srv_log() { logger -t vampn "$*"; echo "$(date '+%F %T') $*" >> "$STATE/vampn.log"; }
srv_inet_ok() { curl -4 -s -o /dev/null -m 8 https://1.1.1.1 || curl -4 -s -o /dev/null -m 8 https://api.timeweb.cloud; }
srv_dhcp_ip() { ip -4 -o addr show dev eth0 scope global dynamic | awk '{split($4,a,"/"); print a[1]; exit}'; }

SRV_AWG_CONF=/etc/amnezia/amneziawg/awg0.conf
PIN_FILE=/etc/netplan/60-vampn-ip.yaml   # закреплённый адрес, если Timeweb по DHCP отдаёт не тот
NOPIN_FILE=/etc/vampn/no-pin             # есть такой файл - сервер сам адрес не закрепляет
EXPECT_TTL=900                           # сообщению homeserv об адресе верим 15 минут (он обновляет его раз в 5)
srv_guard() { # ключ секунд - 0, если с прошлого раза прошло достаточно (не даёт лечению крутиться каждую минуту)
  local t; t=$(now); (( t - $(get "guard_$1" 0) >= $2 )) || return 1; put "guard_$1" "$t"
}
srv_port() { awk -F' *= *' '/^ListenPort/{print $2; exit}' "$SRV_AWG_CONF" 2>/dev/null; }
srv_ifaces_ipv4() { ip -4 -o addr show dev eth0 scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]}'; }
srv_pinned_ip() { [[ -f $PIN_FILE ]] && grep -Eo '[0-9]{1,3}(\.[0-9]{1,3}){3}' "$PIN_FILE" | head -1; }
srv_private_ip() { [[ $1 =~ ^(10\.|127\.|192\.168\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.) ]]; }
srv_expect() { get expect_ip "none 0"; }   # "IP метка_времени": какой адрес Timeweb выдал серверу, по словам homeserv
detect_public_ip() { # внешний IPv4 так, как его видит интернет (у серверов Timeweb он бывает не на eth0)
  local u ip
  for u in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    ip=$(curl -4 -s -m 8 "$u" 2>/dev/null | tr -d '[:space:]')
    [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && ! srv_private_ip "$ip" && { echo "$ip"; return 0; }
  done
  return 1
}
srv_effective_ip() { # адрес сервера для ключей: свежее сообщение homeserv (если этот адрес на eth0), иначе от DHCP
  local e ip ts
  if [[ -f ${BASE:-/root/vampn}/standalone ]]; then detect_public_ip; return 0; fi   # сервер без homeserv: адрес узнаём снаружи
  e=$(srv_expect); ip=${e% *}; ts=${e#* }
  if [[ $ip != none ]] && (( $(now) - ts < EXPECT_TTL )) && srv_ifaces_ipv4 | grep -qx "$ip"; then echo "$ip"; else srv_dhcp_ip; fi
}
srv_netplan_apply() { netplan generate >/dev/null 2>&1 && netplan apply >/dev/null 2>&1; }

srv_heal_services() {
  local port
  nft list table inet filter >/dev/null 2>&1 || { srv_log "nftables не загружен - загружаю"; systemctl restart nftables; }
  ip link show awg0 >/dev/null 2>&1 || { srv_log "awg0 нет - поднимаю"; systemctl restart awg-quick@awg0; }
  port=$(srv_port)
  if ip link show awg0 >/dev/null 2>&1 && [[ -n $port ]] && srv_guard svc 300; then
    # интерфейс есть, но лежит, не слушает порт VPN или порт закрыт фильтром - обычные «тихие» поломки
    if ! ip link show awg0 | grep -q ',UP'; then srv_log "awg0 не поднят (UP) - перезапускаю"; systemctl restart awg-quick@awg0
    elif ! ss -lunH "sport = :$port" 2>/dev/null | grep -q .; then srv_log "порт $port не слушается - перезапускаю awg0"; systemctl restart awg-quick@awg0
    elif ! nft list chain inet filter input 2>/dev/null | grep -q "udp dport $port"; then srv_log "в фильтре нет правила для порта $port - перезагружаю nftables"; systemctl restart nftables
    fi
  fi
  [[ $(sysctl -n net.ipv4.ip_forward 2>/dev/null) == 1 ]] || { srv_log "ip_forward выключен - включаю"; sysctl -qw net.ipv4.ip_forward=1; }
  if systemctl is-enabled --quiet ssh 2>/dev/null && ! systemctl is-active --quiet ssh && srv_guard ssh 300; then
    srv_log "sshd не запущен - запускаю"; systemctl start ssh
  fi
}

srv_pin_expected() { # homeserv сказал, какой адрес выдан серверу; если его нет на eth0 (Timeweb не отдал по DHCP) - закрепляем
  local e ip ts
  e=$(srv_expect); ip=${e% *}; ts=${e#* }
  [[ $ip == none || -f $NOPIN_FILE ]] && return 0
  (( $(now) - ts < EXPECT_TTL )) || return 0       # сообщение устарело (homeserv давно не выходил на связь) - не верим
  srv_ifaces_ipv4 | grep -qx "$ip" && return 0
  srv_guard pin 120 || return 0
  srv_log "homeserv сообщил адрес $ip, а на eth0 его нет (DHCP отдаёт $(srv_dhcp_ip)) - закрепляю"
  printf 'network:\n  version: 2\n  ethernets:\n    eth0:\n      addresses:\n        - %s/32\n' "$ip" > "$PIN_FILE"; chmod 600 "$PIN_FILE"
  if srv_netplan_apply && srv_ifaces_ipv4 | grep -qx "$ip"; then srv_log "адрес $ip закреплён"
  else srv_log "закрепить адрес $ip не вышло - убираю файл"; rm -f "$PIN_FILE"; srv_netplan_apply; fi
}

srv_unpin() { # команда homeserv: снять закрепление адреса и забыть сообщение об адресе (если сервер получил чужой), вернуть адрес из DHCP
  local ip f
  rm -f "$PIN_FILE" "$STATE/expect_ip" "$BASE/mail_pending"; srv_netplan_apply
  ip=$(srv_dhcp_ip)
  if [[ -n $ip && $ip != "$ENDPOINT_IP" ]]; then
    echo "$ip" > "$BASE/endpoint"; ENDPOINT_IP=$ip
    for f in "$CL"/*.env; do [[ -f $f ]] && render "$(basename "$f" .env)"; done
  fi
  srv_log "закрепление снято по команде homeserv, адрес сервера: ${ip:-?}"; echo "ok ${ip:-?}"
}

srv_expect_ip() { # IP - команда homeserv (ключ users): адрес, выданный этому серверу в Timeweb
  local ip=${1:-}
  [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "плохой IP: $ip"
  srv_private_ip "$ip" && die "частный адрес $ip не принимаю"
  put expect_ip "$ip $(now)"
  srv_pin_expected
  echo "ok $ip"
}
srv_heal_network() {
  local f t boots
  systemctl is-active --quiet systemd-networkd || { srv_log "systemd-networkd не запущен - запускаю"; systemctl start systemd-networkd; }
  ip link show eth0 2>/dev/null | grep -q ',UP' || { srv_log "eth0 не поднят - поднимаю"; ip link set eth0 up; }
  if { [[ -z $(srv_ifaces_ipv4) ]] || ! ip -4 route show default | grep -q .; } && srv_guard netfix 120; then
    srv_log "на eth0 нет IPv4 или маршрута по умолчанию - переподключаю"; networkctl reconfigure eth0
  fi
  if srv_inet_ok; then
    (( $(get net_fails) > 0 )) && srv_log "интернет вернулся после $(get net_fails) мин"
    put net_fails 0; return 0
  fi
  f=$(( $(get net_fails) + 1 )); put net_fails "$f"
  srv_log "нет интернета, минут: $f"
  case $f in
    3) srv_log "переподключаю eth0"; networkctl reconfigure eth0 ;;
    6) srv_log "перезапускаю systemd-networkd"; systemctl restart systemd-networkd ;;
  esac
  if (( f >= 10 )); then
    t=$(now); boots=$(awk -v d=$((t-86400)) '$1>d' "$STATE/reboots" 2>/dev/null | wc -l)
    if (( t - $(get last_reboot) >= 3600 && boots < 4 )); then
      srv_log "интернета нет $f мин - перезагрузка"
      put last_reboot "$t"; echo "$t" >> "$STATE/reboots"; put net_fails 0
      systemctl reboot
    fi
  fi
  return 1
}

srv_follow_ip() {
  local ip
  if [[ -f $BASE/mail_pending && -n $(find "$BASE/mail_pending" -mmin +1440) ]]; then
    srv_log "рассылку бросаю через сутки, дошло: $(wc -l < "$BASE/mail_pending")"; rm -f "$BASE/mail_pending"
  fi
  if [[ -f $BASE/mail_pending ]]; then
    mailpy --all --reason "$ROTATION_REASON" >/dev/null 2>&1 && rm -f "$BASE/mail_pending"
  fi
  ip=$(srv_effective_ip)
  [[ -z $ip || $ip == "$ENDPOINT_IP" ]] && return 0
  srv_log "публичный IPv4 сменился: $ENDPOINT_IP -> $ip"
  endpoint_change "$ip" >/dev/null 2>&1 || srv_log "рассылка после смены IP с ошибками, повторю"
}

srv_status() {
  echo "IPv4 (DHCP)  : $(srv_dhcp_ip)   в конфигах: $ENDPOINT_IP$([[ -n $(srv_pinned_ip) ]] && echo "   закреплён вручную/самолечением: $(srv_pinned_ip)")"
  echo "интернет     : $(srv_inet_ok && echo есть || echo НЕТ), минут без него: $(get net_fails)"
  echo "awg0         : $(ip link show awg0 >/dev/null 2>&1 && echo поднят || echo НЕТ), nftables: $(nft list table inet filter >/dev/null 2>&1 && echo загружен || echo НЕТ)"
  echo "рассылка     : $([[ -f $BASE/mail_pending ]] && echo "не завершена, дошло $(wc -l < "$BASE/mail_pending")" || echo ok)"
  echo "журнал       :"; { tail -6 "$STATE/vampn.log" 2>/dev/null || true; } | sed 's/^/  /'
}

srv_users_push() {  # список пользователей приходит с homeserv на stdin
  local tmp; tmp=$(mktemp); head -c 1000000 > "$tmp"
  exec 9>/run/vampn.lock; flock -w 300 9
  { echo "# КОПИЯ. Настоящий список - на homeserv: /etc/vampn/users.conf, правьте его там."
    echo "# Этот файл перезаписывается при каждом изменении на homeserv."
    cat "$tmp"; } > /etc/vampn/users.conf
  chmod 600 /etc/vampn/users.conf; rm -f "$tmp"
  srv_log "список пользователей получен с homeserv - применяю"
  sync_users 2>&1 | while read -r l; do srv_log "users: $l"; echo "$l"; done
}

srv_snapshot() {  # только чтение: настройки сервера без ключей (по нему собирается установочный бандл)
  local f
  echo "### os";        . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}"; uname -r
  echo "### packages";  dpkg -l 2>/dev/null | awk '/^ii/ && $2 ~ /amnez|dkms|nftables|netplan|openssh-server|^curl$|^jq$|^python3$|resolvconf|unattended|chrony|timesyncd/ {print $2, $3}'
  echo "### apt";       for f in /etc/apt/sources.list.d/amnezia*; do [[ -f $f ]] && { echo "-- $f"; cat "$f"; }; done
  echo "### awg0.conf (без ключей)"; sed '/^\[Peer\]/,$d' "$SRV_AWG_CONF" 2>/dev/null | grep -vE '^(PrivateKey|PresharedKey)'
  echo "### nft";       nft list ruleset 2>&1
  echo "### sysctl";    cat /etc/sysctl.d/*.conf /etc/sysctl.conf 2>/dev/null | grep -vE '^\s*(#|$)'
  echo "### sshd";      sshd -T 2>/dev/null | grep -E '^(port|permitrootlogin|passwordauthentication|pubkeyauthentication|listenaddress|kbdinteractiveauthentication) '
  for f in /etc/ssh/sshd_config.d/*.conf; do [[ -f $f ]] && { echo "-- $f"; grep -vE '^\s*(#|$)' "$f"; }; done
  echo "### authorized_keys (тела ключей скрыты)"
  sed -E 's#(ssh-[a-z0-9-]+|ecdsa-[a-z0-9-]+|sk-[a-z0-9@.-]+) [A-Za-z0-9+/=]+#\1 <key>#' /root/.ssh/authorized_keys 2>/dev/null
  echo "### units";     systemctl cat vampn.service vampn.timer 2>&1 | head -40
  echo "### enabled";   systemctl is-enabled awg-quick@awg0 nftables vampn.timer ssh sshd systemd-networkd 2>&1
  echo "### netplan";   cat /etc/netplan/*.yaml 2>/dev/null
  echo "### etc/vampn"; ls -la /etc/vampn 2>&1
  echo "### data";      ls -la "$BASE" "$STATE" 2>&1 | head -40
  echo "### server.env (без ключей)"; grep -vE 'PRIV|PSK' "$BASE/server.env" 2>/dev/null
  for f in setup_awg.sh nftables.conf.tpl; do [[ -f $BASE/$f ]] && { echo "### $f"; grep -vE 'PRIVKEY=\S{20,}|PSK=\S{20,}' "$BASE/$f"; }; done
  echo "### nftables.conf"; cat /etc/nftables.conf 2>/dev/null
}

srv_home_init() {  # локально, при установке: пир homeserv (адрес .3) для туннеля homeserv -> этот сервер. Повторный вызов ничего не меняет.
  local f=$CL/homeserv.env sk
  if [[ ! -f $f ]]; then
    sk=$(awg genkey)
    ( umask 077; cat > "$f" <<EOF
NAME=homeserv
EMAIL=
IP=$SUBNET.3
PRIVKEY=$sk
PUBKEY=$(echo "$sk" | awg pubkey)
PSK=$(awg genpsk)
CREATED=$(date -Iseconds)
EOF
    )
    render homeserv; sync_server
  fi
}
srv_home_conf() {  # локально: конфиг туннеля для homeserv (адрес сервера - как в endpoint). Его же берёт vampn spawn.
  render homeserv; cat "$CL/homeserv.conf"
}

srv_add() {  # ИМЯ [ПОЧТА] - новый пользователь на сервере без homeserv: печатает конфиг, QR и ссылку для приложения AmneziaVPN
  local n=${1:-}
  [[ -n $n ]] || die "vampn add ИМЯ [почта]"
  user_add "$n" "${2:-}"
  echo "LOCAL=1" >> "$CL/$n.env"
  echo "=== конфиг $n (AmneziaWG; файл $CL/$n.conf) ==="
  cat "$CL/$n.conf"
  echo "=== QR для приложения AmneziaVPN / AmneziaWG ==="
  qrencode -t ansiutf8 < "$CL/$n.conf" 2>/dev/null || true
  echo "=== ссылка для импорта в AmneziaVPN ==="
  mailpy --link "$n" 2>/dev/null || true
}

srv_user_cmd() {  # reissue|resend|link ИМЯ
  local n=${2:-}
  [[ $n =~ ^[a-zA-Z0-9_.-]{1,32}$ ]] || die "нужно имя пользователя: vampn $1 ИМЯ"
  [[ -f $CL/$n.env ]] || die "нет пользователя $n"
  case $1 in
    reissue) srv_log "перевыпуск ключа $n"; user_reissue "$n" ;;
    resend)  mailpy "$n" ;;
    link)    mailpy --link "$n" ;;
  esac
}

server_main() {
  local cmd=${1:-check}
  case $cmd in
    check)
      exec 9>/run/vampn.lock; flock -n 9 || exit 0
      data_init; srv_heal_services
      srv_pin_expected; srv_heal_network && srv_follow_ip ;;
    status) data_init; srv_status ;;
    add)    data_init; srv_add "${2:-}" "${3:-}" ;;
    del)    data_init; valid_name "${2:-}"; [[ -f $CL/$2.env ]] || die "нет пользователя $2"; user_del "$2"; echo "удалён $2" ;;
    list)   data_init; users_list ;;
    peers)  data_init; users_peers ;;
    reissue|resend|link) data_init; srv_user_cmd "$@" ;;
    userspush) data_init; srv_users_push ;;
    expectip)  data_init; srv_expect_ip "${2:-}" ;;
    unpin)      data_init; srv_unpin ;;
    snapshot)   data_init; srv_snapshot ;;
    homeinit)  data_init; srv_home_init ;;     # только локально (не в списке remote): ставит install.sh
    homeconf)  data_init; srv_home_conf ;;
    remote)  # принудительная команда ключа homeserv: разрешён только этот список действий
      local a; read -r -a a <<<"${SSH_ORIGINAL_COMMAND:-userspush}"
      case ${a[0]:-} in    # старые имена с дефисом принимаются только от ещё не обновлённого homeserv
        users-push) a[0]=userspush ;;
        expect-ip)  a[0]=expectip ;;
      esac
      case ${a[0]:-} in
        userspush|list|peers|status|selfupdate) exec "$SELF" "${a[0]}" ;;
        reissue|resend|link|expectip)    exec "$SELF" "${a[0]}" "${a[1]:-}" ;;
        unpin)    exec "$SELF" unpin ;;
        snapshot) exec "$SELF" snapshot ;;
        *) die "команда не разрешена: ${a[0]:-}" ;;
      esac ;;
    *) echo "vampn: неизвестная команда «$cmd»" >&2; usage 1 ;;
  esac
}

# ====================================================================================================
# Аварийный сервер (Бостон, /etc/vampn/role = emergency). В обычное время VPN выключен: awg0 не поднят,
# порт VPN закрыт, сервер держит свои сайты. homeserv включает его командой vampn emergency on
# (присылает свежие данные пользователей) и сам выключает, когда Timeweb снова доступен.
# Те же ключи сервера, пользователей и параметры маскировки, что на Timeweb: отличается только адрес.
# ====================================================================================================
em_log() { logger -t vampn "$*"; echo "$(date '+%F %T') $*" >> "$STATE/vampn.log"; }
em_port() { awk -F' *= *' '/^ListenPort/{print $2}' "$SRV_CONF"; }
em_port_open() { local s; s=$(nft list set inet filter em_ports 2>/dev/null); [[ $s == *"elements"* ]]; }
em_up() {
  ip link show awg0 >/dev/null 2>&1 || systemctl start awg-quick@awg0
  nft add element inet filter em_ports "{ $(em_port) }" 2>/dev/null || true
}
em_down() {
  nft delete element inet filter em_ports "{ $(em_port) }" 2>/dev/null || true
  systemctl stop awg-quick@awg0 2>/dev/null || true
}
em_on() {  # stdin: tar.gz с server.env и clients/ (копия данных с homeserv)
  local tmp; tmp=$(mktemp -d)
  head -c 20000000 | tar -xzf - -C "$tmp" 2>/dev/null
  [[ -f $tmp/server.env && -d $tmp/clients ]] || { rm -rf "$tmp"; die "не пришли данные пользователей"; }
  rm -rf "$BASE/clients"; mkdir -p "$BASE"
  cp "$tmp/server.env" "$BASE/server.env"; mv "$tmp/clients" "$BASE/clients"; rm -rf "$tmp"
  hostname -I | awk '{print $1}' > "$BASE/endpoint"
  chmod -R go-rwx "$BASE"
  data_init; sync_server
  touch "$STATE/emergency_on"; em_up
  em_log "аварийный режим ВКЛЮЧЁН, пользователей $(ls "$CL"/*.env | wc -l)"
  echo "on: $(ls "$CL"/*.env | wc -l) пользователей, порт $(em_port)"
}
em_off() {
  rm -f "$STATE/emergency_on"; em_down
  em_log "аварийный режим выключен"; echo off
}
em_status() {
  echo "режим        : $([[ -f $STATE/emergency_on ]] && echo "АВАРИЙНЫЙ (VPN работает)" || echo "обычный (VPN выключен)")"
  echo "awg0         : $(ip link show awg0 >/dev/null 2>&1 && echo поднят || echo нет), порт открыт: $(em_port_open && echo да || echo нет)"
  echo "журнал       :"; { tail -4 "$STATE/vampn.log" 2>/dev/null || true; } | sed 's/^/  /'
}
emergency_main() {
  case ${1:-} in
    remote)  # принудительная команда ключа homeserv
      local a; read -r -a a <<<"${SSH_ORIGINAL_COMMAND:-}"
      case ${a[0]:-} in on|off|peers|status|selfupdate) exec "$SELF" "${a[0]}" ;; *) die "команда не разрешена: ${a[0]:-}" ;; esac ;;
    on)     exec 9>/run/vampn.lock; flock -w 60 9; em_on ;;
    off)    exec 9>/run/vampn.lock; flock -w 60 9; em_off ;;
    status) em_status ;;
    peers)  data_init; users_peers ;;   # только чтение; пусто, пока аварийный режим выключен (awg0 не поднят)
    check)  # таймер: после перезагрузки вернуть то состояние, которое было
      exec 9>/run/vampn.lock; flock -n 9 || exit 0
      if [[ -f $STATE/emergency_on ]]; then
        { ip link show awg0 >/dev/null 2>&1 && em_port_open; } || { em_log "восстанавливаю аварийный режим"; em_up; }
      else
        if ip link show awg0 >/dev/null 2>&1; then em_log "VPN поднят без аварийного режима - выключаю"; em_down; fi
      fi
      exit 0 ;;
    *) echo "vampn: неизвестная команда «${1:-}»" >&2; usage 1 ;;
  esac
}

# ====================================================================================================
# homeserv: сторож VPN-сервера. Раз в минуту проверяет туннель; если он мёртв, а интернет у homeserv есть:
#   2 мин без связи -> перезагрузка сервера через API Timeweb
#   3 мин без связи -> аварийный канал (Бостон) включается сам, аварийные ключи уходят на почту
#   5 мин без связи -> смена IPv4: Timeweb выдаёт новый адрес, с homeserv проверяется трассой, что до него
#   доходят пакеты (если нет - адрес убирается и берётся следующий, до 6 попыток); старый удаляется только
#   после этого. Ключи рассылаются один раз и только после НОВОГО рукопожатия и ответа через туннель.
#   После смены IP связи нет 150 с (ещё 120 с, если сервер в Timeweb не on) -> жёсткая перезагрузка; такая смена в лимит
#   не считается, повтор через 3 мин, но не больше 3 неудач подряд (дальше нужна проверка вручную).
#   Удачные смены: не чаще раза в час и не больше 4 в сутки. Менять IP можно только при статусе on.
#   Перезагрузка не чаще раза в 30 мин. Сервер выключен -> включает.
#   Связь = свежее рукопожатие (моложе 45 с) или ответ sshd VPS через туннель (TCP 22 открыт для awg0).
# Сообщения: Telegram (tg notify alerts) + письмо - Telegram ходит через этот же туннель. Одно сообщение
# на одну аварию. Пока туннель жив: применяет users.conf, раз в 10 мин копирует данные пользователей.
# ====================================================================================================
IFACE=$TUN_IFACE
TUN_CONF=/etc/amnezia/amneziawg/$TUN_IFACE.conf
MIRROR=$STATE/mirror
API=https://api.timeweb.cloud/api/v1
HS_FRESH=45 PROBE_TRIES=3 PROBE_TIMEOUT=3 PROBE_HOST=$SRV_TIP
REBOOT_AT=2 ROTATE_AT=5 REBOOT_GAP=$((30*60)) ROUTE_MIN_HOP=4
ROTATE_RETRY=180 ROTATE_RETRY_SLOW=300 ATT_FAST=3 ATT_MAX=20   # попытки вернуть связь: первые 3 раз в 3 мин, дальше раз в 5 мин, всего на двух серверах не больше 20
MAX_ROT_PER_DAY=4 MIRROR_EVERY=600
IP_LIMIT=10 IP_RESERVE=1   # Timeweb даёт 10 новых IP в сутки на аккаунт (считается каждый созданный, даже удалённый); 1 оставляем на ручную смену
EM_AT=3 HS_WAIT=150 HS_WAIT_EXTRA=120
srv_ssh_init() { # свой отпечаток ключа у каждого сервера (/etc/vampn/known_hosts_1 и _2): ключи tunnel-пира у серверов одни, а хосты разные,
  # и homeserv не должен молча говорить не с тем сервером. Нет файла - общий mirror.known_hosts, как раньше.
  local d=${VAMPN_ETC:-/etc/vampn} kh; kh=$d/mirror.known_hosts; [[ -s $d/known_hosts_${TARGET:-1} ]] && kh=$d/known_hosts_${TARGET:-1}
  (( ${CELL:-1} > 1 )) && kh=$d/cells/$CELL.known_hosts   # у ячейки свой сервер и свой отпечаток; нет файла - ssh не доверяет молча (accept-new запишет при первом разе)
  SSH_SRV=(ssh -T -o LogLevel=ERROR -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10
           -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$kh")
}
srv_ssh_init

log() { echo "$(date '+%F %T') $*" | tee -a "$STATE/vampn.log" >&2; }
notify() { # текст [mail]
  log "notify: $1"
  tg notify alerts "🛡 $1" >/dev/null 2>&1 || true
  [[ ${2:-} == mail ]] && { printf '%s\n\n%s\n' "$1" "$(status 2>&1)" | mailpy --alert "$1" >/dev/null 2>&1 || log "письмо-тревога не ушло"; }
}
once() { # ключ текст - одно сообщение на одну аварию (флаги сбрасываются, когда связь вернулась)
  [[ -f $STATE/once_$1 ]] && return 0
  touch "$STATE/once_$1"; notify "$2" mail
}
throttle() { # ключ секунд текст [mail] - одно и то же сообщение не чаще раза в N секунд; пока причина держится, Telegram не засоряется
  local key=$1 gap=$2 t; t=$(now)
  if (( t - $(get "thr_$key") < gap )); then log "(повтор, без уведомления) $3"; return 0; fi
  put "thr_$key" "$t"; notify "$3" "${4:-}"
}
# --- лимит Timeweb на создание IP ---
# Состояние лимита ведётся отдельно для каждого сервера Timeweb: к имени метки добавляется $TSUF ("" - основной, "_2" - запасной).
until_active() { # имя метки со сроком: 0, пока срок не вышел; просроченную метку убирает вместе с «уже сообщал»
  local u; u=$(get "$1$TSUF")
  (( u > $(now) )) && return 0
  [[ -e $STATE/$1$TSUF ]] && rm -f "$STATE/$1$TSUF" "$STATE/thr_limit$TSUF"
  return 1
}
rot_blocked() { until_active rot_blocked_until; }   # срок назвал сам Timeweb: IP не создать, ждёт и ручная смена
rot_paused() { until_active rot_paused_until; }     # наш резерв: автосмена ждёт, ручная --force проходит
rot_wait_until() { local a b; a=$(get "rot_blocked_until$TSUF"); b=$(get "rot_paused_until$TSUF"); echo $(( a > b ? a : b )); }
block_until() { # имя-метки метка-времени текст: ставит паузу смены IP на этом сервере и один раз сообщает
  put "$1$TSUF" "$2"
  throttle "limit$TSUF" $((6*3600)) "[$(tw_label)] $3 Смену IP на этом сервере поставил на паузу до $(TZ=Europe/Moscow date -d @"$2" '+%d.%m %H:%M') МСК, до тех пор об этом больше не пишу." mail
}
tw_limit_block() { # $1 - ответ API на создание IP; 0, если это daily_limit_exceeded (срок берётся из ответа)
  local ts
  [[ $(jq -r '.error_code // empty' <<<"$1" 2>/dev/null) == daily_limit_exceeded ]] || return 1
  ts=$(date -d "$(jq -r '.details.available_date_for_creation // empty' <<<"$1" 2>/dev/null)" +%s 2>/dev/null) || ts=""
  [[ $ts =~ ^[0-9]+$ ]] && (( ts > $(now) )) || ts=$(( $(now) + 3600 ))
  block_until rot_blocked_until "$ts" "Timeweb: лимит новых IP в сутки исчерпан ($IP_LIMIT)."
}
ip_created() { echo "$(now)" >> "$STATE/ip_creations$TSUF"; tail -n 50 "$STATE/ip_creations$TSUF" > "$STATE/ip_creations$TSUF.n" && mv -f "$STATE/ip_creations$TSUF.n" "$STATE/ip_creations$TSUF"; }
ip_used_24h() { awk -v d=$(( $(now) - 86400 )) '$1>d' "$STATE/ip_creations$TSUF" 2>/dev/null | wc -l; }
ip_budget_ok() { # свои же счётчики: автосмена не берёт последние IP_RESERVE создавания суток
  local used; used=$(ip_used_24h)
  (( used < IP_LIMIT - IP_RESERVE )) && return 0
  block_until rot_paused_until "$(awk -v d=$(( $(now) - 86400 )) '$1>d{print $1+86400+60; exit}' "$STATE/ip_creations$TSUF")" \
    "За сутки уже создано $used новых IP из $IP_LIMIT (лимит Timeweb), $IP_RESERVE оставляю на ручную смену."
  return 1
}
# Два сервера Timeweb: 1 - основной (/etc/vampn/timeweb.env), 2 - запасной (/etc/vampn/timeweb2.env, клон основного).
TW_ENV1=/etc/vampn/timeweb.env TW_ENV2=/etc/vampn/timeweb2.env
(( CELL > 1 )) && { TW_ENV1=${VAMPN_ETC:-/etc/vampn}/cells/$CELL.timeweb.env; TW_ENV2=/nonexistent; }   # у ячейки свой сервер Timeweb, запасного нет
TARGET=1 TSUF=""
tw_targets() { [[ -f $TW_ENV2 ]] && echo "1 2" || echo 1; }
tw_label() { [[ ${TARGET:-1} == 1 ]] && echo "основной" || echo "запасной"; }
tw_use() { # 1|2 - с какого сервера Timeweb работаем дальше; 1 если такого нет
  local f=$TW_ENV1; [[ ${1:-1} == 2 ]] && f=$TW_ENV2
  [[ -f $f ]] || { log "нет файла $f"; return 1; }
  TIMEWEB_TOKEN="" TIMEWEB_SERVER_ID=""
  set -a; . "$f"; set +a
  : "${TIMEWEB_TOKEN:?нет TIMEWEB_TOKEN в $f}" "${TIMEWEB_SERVER_ID:?нет TIMEWEB_SERVER_ID в $f}"
  TARGET=${1:-1}; TSUF=""; [[ $TARGET == 2 ]] && TSUF=_2
  srv_ssh_init
  return 0
}
tw_init() { tw_use "$(get active_target 1)" || tw_use 1; }
api() { curl -sS -m 30 -X "$1" -H "Authorization: Bearer $TIMEWEB_TOKEN" -H 'Content-Type: application/json' ${3:+-d "$3"} "$API$2"; }
ips_json() { api GET "/servers/$TIMEWEB_SERVER_ID/ips"; }
tw_status() { api GET "/servers/$TIMEWEB_SERVER_ID" | jq -r '.server.status // "unknown"'; }
main_ipv4() { ips_json | jq -r '[.server_ips[]? | select(.type=="ipv4")] | (map(select(.is_main)) + .)[0].ip // empty'; }
all_ipv4() { ips_json | jq -r '.server_ips[]? | select(.type=="ipv4") | .ip'; }
tun_endpoint() { awk -F'[ =:]+' '/^Endpoint/{print $2}' "$TUN_CONF"; }
tun_port() { awk -F: '/^Endpoint/{print $NF}' "$TUN_CONF" | tr -d ' '; }
hs_age() {
  local t; t=$(awg show "$IFACE" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
  [[ -z $t || $t == 0 ]] && { echo 999999; return; }
  echo $(( $(now) - t ))
}
# TCP до sshd VPS именно через основной туннель (interface $IFACE): на VPS порт 22 открыт только для awg0.
# Это не зависит от возраста рукопожатия, поэтому падение видно за секунды, а не через 300 с.
probe_tunnel() { # [попыток]
  local i t
  for ((i=1; i<=${1:-$PROBE_TRIES}; i++)); do
    t=$(curl -s -o /dev/null --interface "$IFACE" --connect-timeout "$PROBE_TIMEOUT" -m "$((PROBE_TIMEOUT+1))" \
         -w '%{time_connect}' "telnet://$PROBE_HOST:22" 2>/dev/null)
    [[ -n $t && $t != 0 && $t != 0.000000 ]] && return 0
  done
  return 1
}
alive() { (( $(hs_age) < HS_FRESH )) || probe_tunnel; }
# адрес проходим, если трасса с homeserv идёт дальше узлов провайдера (режущийся диапазон обрывается на 3-м узле)
ip_routed() { timeout 45 traceroute -n -I -w 2 -q 1 -m 8 "$1" 2>&1 | awk -v m="$ROUTE_MIN_HOP" 'NR>1 && ($1+0)>=m && $2!="*"{ok=1} END{exit !ok}'; }
inet_ok() { curl -s -o /dev/null -m 10 https://ya.ru || curl -s -o /dev/null -m 10 https://vk.com; }

tun_set_endpoint() { # IP - перевести свой туннель на новый адрес сервера
  local ip=$1 p; p=$(tun_port)
  [[ $(tun_endpoint) == "$ip" ]] && return 0
  sed -i -E "s|^Endpoint *=.*|Endpoint = $ip:$p|" "$TUN_CONF"
  awg set "$IFACE" peer "$(awg show "$IFACE" peers | head -1)" endpoint "$ip:$p"
  log "туннель -> $ip:$p"
}

tun_keep_endpoint() { # пир туннеля «переезжает» на того, кто написал первым; если уехал не туда, куда велено - возвращаем
  local rt want p; want=$(tun_endpoint); p=$(tun_port)
  rt=$(awg show "$IFACE" endpoints 2>/dev/null | awk '{split($2,a,":"); print a[1]; exit}')
  [[ -n $rt && -n $want && $rt != "$want" ]] || return 0
  log "туннель уехал на $rt (сервер написал первым) - возвращаю на $want"
  awg set "$IFACE" peer "$(awg show "$IFACE" peers | head -1)" endpoint "$want:$p"
}

wait_new_handshake() { # метка_времени секунд - рукопожатие должно быть НОВЕЕ метки и сервер отвечает через туннель
  local since=$1 end=$(( $(now) + $2 )) t ok
  while (( $(now) < end )); do
    probe_tunnel 1 && ok=1 || ok=0          # заодно гоняет трафик, чтобы туннель начал рукопожатие
    t=$(awg show "$IFACE" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
    if (( ok )) && [[ -n $t && $t != 0 ]] && (( t > since )); then return 0; fi
    sleep 5
  done
  return 1
}

do_reboot() { # [hard]
  local action=reboot code; [[ ${1:-} == hard ]] && action=hard_reboot
  code=$(curl -sS -m 30 -o /dev/null -w '%{http_code}' -X POST -H "Authorization: Bearer $TIMEWEB_TOKEN" \
         -H 'Content-Type: application/json' -d "{\"action\":\"$action\"}" "$API/servers/$TIMEWEB_SERVER_ID/action")
  put last_reboot "$(now)"; log "$action: HTTP $code"
  [[ $code == 2* ]]
}

pull_mirror() { # копия данных пользователей с сервера (ключ с принудительной командой tar, только чтение)
  local tmp; tmp=$(mktemp -d)
  if "${SSH_SRV[@]}" -i /etc/vampn/mirror.key root@$SRV_TIP 2>/dev/null | tar -xzf - -C "$tmp" 2>/dev/null \
     && [[ -f $tmp/server.env && -d $tmp/clients ]]; then
    chmod 700 "$tmp"; rm -rf "$MIRROR.old"; [[ -d $MIRROR ]] && mv "$MIRROR" "$MIRROR.old"
    mv "$tmp" "$MIRROR"; rm -rf "$MIRROR.old"; put last_mirror "$(now)"
    return 0
  fi
  rm -rf "$tmp"; log "копия данных: не удалось скопировать с сервера"; return 1
}

remote() { "${SSH_SRV[@]}" -i /etc/vampn/users.key root@$SRV_TIP "$1" </dev/null; }
push_expect() { # [IP] - сообщить активному VPN-серверу, какой адрес ему выдан в Timeweb (он закрепит его, если Timeweb не отдал по DHCP)
  local ip=${1:-} last t; t=$(now)
  [[ -n $ip ]] || ip=$(main_ipv4); [[ -n $ip ]] || return 1
  last=$(get "expect_pushed$TSUF" "none 0")
  [[ -z ${1:-} && ${last% *} == "$ip" ]] && (( t - ${last#* } < EXPECT_EVERY )) && return 0
  if remote "expectip $ip" >/dev/null 2>&1; then put "expect_pushed$TSUF" "$ip $t"; return 0; fi
  return 1
}
announce_ip() { # СТАРЫЙ НОВЫЙ - перед удалением старого IP сообщить серверу новый: активному - через туннель, неактивному - прямо на старый адрес (порт 22, если открыт)
  local old=$1 new=$2 out=""
  if [[ $n == "$(get active_target 1)" ]]; then
    alive && remote "expectip $new" >/dev/null 2>&1 && { log "[$(tw_label)] серверу сообщён новый адрес $new (через туннель)"; return 0; }
  elif [[ -n $old ]]; then
    out=$("${SSH_SRV[@]}" -i /etc/vampn/users.key -o HostKeyAlias=$SRV_TIP -o ConnectTimeout=8 "root@$old" "expectip $new" </dev/null 2>&1) \
      && { log "[$(tw_label)] серверу сообщён новый адрес $new (напрямую на $old)"; return 0; }
  fi
  [[ -n $out ]] && out=" [$(tail -c 80 <<<"$out" | tr '\n' ' ')]"
  log "[$(tw_label)] серверу новый адрес $new сообщить не вышло$out - сервер получит его по DHCP"; return 1
}

# Список пользователей этой ячейки из общего /etc/vampn/users.conf: строки "ИМЯ ПОЧТА [ЯЧЕЙКА]", без номера - ячейка 1.
# Пишет $STATE/users.cell (там уже только ИМЯ ПОЧТА, как ждёт сервер) и печатает путь; нет общего файла - ничего не печатает.
users_conf_file() {
  local src=${VAMPN_USERS:-/etc/vampn/users.conf} o=$STATE/users.cell
  [[ -f $src ]] || return 1
  sed 's/\r$//' "$src" | awk -v c="$CELL" '
    /^[[:space:]]*#/ || NF == 0 { next }
    NF == 3 && $3 ~ /^[0-9]+$/ { if ($3 + 0 == c) print $1, $2; next }
    { if (c == 1) print }' > "$o.new" && mv -f "$o.new" "$o"
  echo "$o"
}

push_users() { # [force] - users.conf изменился -> отправить на сервер и применить
  local f sum out changes
  f=$(users_conf_file) || return 0
  sum=$(sha256sum "$f" | cut -d' ' -f1)
  [[ ${1:-} != force && $sum == "$(get users_pushed none)" ]] && return 0
  if out=$("${SSH_SRV[@]}" -i /etc/vampn/users.key root@$SRV_TIP < "$f" 2>&1); then
    put users_pushed "$sum"
    log "список пользователей применён${out:+: $(tr '\n' ';' <<<"$out")}"
    changes=$(grep -E '^[-+~!]|users.conf' <<<"$out" | sed -e 's/^+ /добавлен /' -e 's/^- /удалён /' -e 's/^~ /сменена почта /' | tr '\n' ';' | sed 's/;$//; s/;/; /g')
    [[ -n $changes ]] && notify "пользователи: $changes"
    pull_mirror >/dev/null 2>&1 || true
    [[ ${1:-} == force ]] && echo "${out:-изменений нет}"
    return 0
  fi
  log "не удалось отправить список пользователей на сервер: $(tail -c 200 <<<"$out")"; return 1
}

mail_from_mirror() { # IP - разослать ключи с новым адресом по копии данных
  [[ -f $MIRROR/server.env ]] || { log "копии данных нет - рассылку сделает сам сервер, когда поднимется"; return 1; }
  if VAMPN_BASE=$MIRROR "$SELF" endpointchange "$1" >>"$STATE/vampn.log" 2>&1; then
    log "ключи с адресом $1 разосланы с homeserv"
    return 0
  fi
  log "рассылка с homeserv завершилась с ошибками"
  return 1
}

# ---------- аварийный режим (Бостон) ----------
EM_ENV=/etc/vampn/emergency.env
(( CELL > 1 )) && EM_ENV=/nonexistent   # аварийный канал (Бостон) только у ячейки 1
EM_IFACE=vampn-e
em_active() { [[ -f $STATE/emergency_on ]]; }
em_init() { [[ -f $EM_ENV ]] || die "нет $EM_ENV"; set -a; . "$EM_ENV"; set +a; : "${EM_HOST:?нет EM_HOST в $EM_ENV}"; }
em_ssh() {
  ssh -T -o LogLevel=ERROR -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15 \
      -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/vampn/emergency.known_hosts \
      -i /etc/vampn/emergency.key "root@$EM_HOST" "$@"
}
em_hs_age() {
  local t; t=$(awg show "$EM_IFACE" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
  [[ -z $t || $t == 0 ]] && { echo 999999; return; }
  echo $(( $(now) - t ))
}
em_tunnel_up() {  # туннель homeserv -> Бостон: тот же ключ, другой адрес, без своих маршрутов
  sed -e "s|^Endpoint *=.*|Endpoint = $EM_HOST:$(tun_port)|" -e '/^\[Interface\]/a Table = off' "$TUN_CONF" \
    > "/etc/amnezia/amneziawg/$EM_IFACE.conf"
  chmod 600 "/etc/amnezia/amneziawg/$EM_IFACE.conf"
  ip link show "$EM_IFACE" >/dev/null 2>&1 || systemctl start "awg-quick@$EM_IFACE"
  ip route replace 10.77.0.1/32 dev "$EM_IFACE"
}
tg_reconnect() { tg --reset-hostkey >/dev/null 2>&1 || true; docker restart tg >/dev/null 2>&1 || true; }

emergency_on() { # [--quiet] - --quiet: без писем пользователям (для проверки)
  em_init
  em_active && { echo "аварийный режим уже включён"; return 0; }
  [[ -f $MIRROR/server.env ]] || die "нет копии данных пользователей ($MIRROR)"
  log "аварийный режим: включаю"
  local out
  if ! out=$(tar -C "$MIRROR" -czf - server.env clients | em_ssh on 2>&1); then
    notify "не смог включить VPN на аварийном сервере: $(tail -c 200 <<<"$out")" mail; return 1
  fi
  log "Бостон: $out"
  em_tunnel_up
  local i; for i in $(seq 12); do (( $(em_hs_age) < 60 )) && break; sleep 5; done
  touch "$STATE/emergency_on"; put em_ok 0
  tg_reconnect
  if (( $(em_hs_age) < 60 )); then
    notify "включён аварийный режим: VPN и Telegram работают через Бостон ($EM_HOST)" mail
  else
    notify "аварийный режим включён, но туннель до Бостона не поднялся за минуту - проверьте" mail
  fi
  [[ ${1:-} == --quiet ]] && return 0
  local d=$STATE/em-mail
  rm -rf "$d"; cp -a "$MIRROR" "$d"; echo "$EM_HOST" > "$d/endpoint"; rm -f "$d/mail_pending"
  VAMPN_KIND=emergency VAMPN_BASE=$d "$SELF" mailsend --all --reason \
    "Основной VPN-сервер сейчас недоступен, включён аварийный канал. Добавьте этот ключ в AmneziaVPN и подключайтесь через него. Когда основной сервер заработает, придёт письмо." \
    >>"$STATE/vampn.log" 2>&1 && log "аварийные ключи разосланы" || log "рассылка аварийных ключей с ошибками"
}

emergency_off() { # [--quiet]
  em_init
  em_active || { echo "аварийный режим не включён"; return 0; }
  log "аварийный режим: выключаю"
  ip route replace "$SRV_TIP/32" dev "$IFACE"
  systemctl stop "awg-quick@$EM_IFACE" 2>/dev/null || true
  em_ssh off >/dev/null 2>&1 || log "Бостон не ответил на off - VPN там выключится сам при следующей проверке"
  rm -f "$STATE/emergency_on" "$STATE/down_since" "$STATE"/once_* "$STATE/rotated_in_outage"
  tg_reconnect
  notify "аварийный режим выключен: VPN и Telegram снова работают через Timeweb" mail
  [[ ${1:-} == --quiet ]] && return 0
  printf '%s\n' "Здравствуйте!" "" \
    "Основной VPN-сервер снова работает. Переключитесь в AmneziaVPN на профиль {profile}." \
    "Аварийный профиль {profile}-emergency можно удалить: он заработает, только если снова включат аварийный режим (тогда придёт письмо)." \
    | VAMPN_BASE=$MIRROR "$SELF" mailsend --notice "Ваш VPN: основной сервер снова работает" >>"$STATE/vampn.log" 2>&1 \
    && log "письма о возврате разосланы" || log "письма о возврате: с ошибками"
}

emergency_status() {
  em_init
  echo "аварийный режим: $(em_active && echo "ВКЛЮЧЁН (трафик через Бостон $EM_HOST)" || echo "выключен")"
  em_active && echo "туннель Бостон: рукопожатие $(em_hs_age) с назад; Timeweb жив подряд: $(get em_ok) мин (возврат с 3)"
  echo "--- Бостон:"; em_ssh status 2>&1 | sed 's/^/  /'
}

# ---------- две площадки Timeweb («зебра») ----------
# Основной сервер - /etc/vampn/timeweb.env, запасной (клон основного: те же ключи сервера и пользователей,
# отличается IP) - /etc/vampn/timeweb2.env. Нет второго файла - всё как с одним сервером.
# Попытка = ОДИН новый IP на одном сервере. Попытки идут по очереди: основной, запасной, основной...
# Первые ATT_FAST попыток - раз в ROTATE_RETRY с, дальше реже (ROTATE_RETRY_SLOW), всего не больше ATT_MAX.
# Аварийный канал (Бостон) включается отдельно, через EM_AT мин без связи, и на попытки не влияет.

PROBE_IFACE=vampn-t$( (( CELL > 1 )) && echo "$CELL" )
probe_handshake() { # IP СЕК - отвечает ли VPN-сервер на этом адресе: временный интерфейс с тем же ключом, рабочий туннель не трогаем. 0 - рукопожатие есть
  local ip=$1 secs=$2 conf=/etc/amnezia/amneziawg/$PROBE_IFACE.conf end h p ok=1
  p=$(tun_port)
  sed -E -e "s|^Endpoint *=.*|Endpoint = $ip:$p|" -e "s|^Address *=.*|Address = $HOME_TIP/32|" \
         -e '/^(DNS|PostUp|PostDown|PreUp|PreDown|PersistentKeepalive|Table)/d' "$TUN_CONF" > "$conf"
  # Table = off: маршрутов не добавляем, рабочий туннель не затрагивается; keepalive 1 с - рукопожатие стартует само, без трафика через маршруты
  sed -i -e '/^\[Interface\]/a Table = off' -e '/^\[Peer\]/a PersistentKeepalive = 1' "$conf"; chmod 600 "$conf"
  awg-quick down "$PROBE_IFACE" >/dev/null 2>&1 || true
  if awg-quick up "$PROBE_IFACE" >/dev/null 2>&1; then
    end=$(( $(now) + secs ))
    while (( $(now) < end )); do
      h=$(awg show "$PROBE_IFACE" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
      if (( ${h:-0} > 0 )); then ok=0; break; fi
      sleep 4
    done
  fi
  awg-quick down "$PROBE_IFACE" >/dev/null 2>&1 || true; rm -f "$conf"
  return $ok
}

attempt() { # N [--force]: одна попытка вернуть связь через сервер N. 0 - туннель поднялся, 1 - не вышло (попытка потрачена), 2 - не начинал (ничего не потрачено)
  local n=$1 force=${2:-} t old new cand resp t0 st ipsj tries cur standby up
  tw_use "$n" || return 2
  t=$(now); tries=$(( $(get att_total) + 1 ))
  if rot_blocked || { [[ $force != --force ]] && rot_paused; }; then   # лимит на создание IP: API не дёргаем, в Telegram молчим
    log "[$(tw_label)] новые IP создавать нельзя до $(date -d @"$(rot_wait_until)" '+%F %T') (лимит Timeweb) - пропускаю"
    [[ $force == --force ]] && echo "смена IP невозможна: Timeweb не даёт создавать новые IP до $(TZ=Europe/Moscow date -d @"$(rot_wait_until)" '+%d.%m %H:%M') МСК"
    return 2
  fi
  st=$(tw_status)
  if [[ $st != on ]]; then
    log "[$(tw_label)] статус сервера в Timeweb $st, а не on - пропускаю"; echo "смена IP отложена: статус сервера в Timeweb $st, дождитесь on"
    if [[ $st == off || $st == stopped ]] && (( t - $(get "last_start$TSUF") >= REBOOT_GAP )); then
      log "[$(tw_label)] включаю сервер (статус $st)"
      api POST "/servers/$TIMEWEB_SERVER_ID/action" '{"action":"start"}' >/dev/null; put "last_start$TSUF" "$t"
    fi
    return 2
  fi
  [[ $force == --force ]] || ip_budget_ok || return 2
  ipsj=$(ips_json)
  if ! jq -e '.server_ips | type == "array"' >/dev/null 2>&1 <<<"$ipsj"; then
    throttle "ips_api$TSUF" 3600 "[$(tw_label)] не получил список IP из API Timeweb: $(head -c 200 <<<"$ipsj")" mail; return 2
  fi
  old=$(jq -r '[.server_ips[]? | select(.type=="ipv4")] | (map(select(.is_main)) + .)[0].ip // empty' <<<"$ipsj")
  if [[ -z $old ]]; then   # список получен, но IPv4 у сервера нет вообще: нечего удалять, просто заводим новый
    throttle "noip$TSUF" $((6*3600)) "[$(tw_label)] у сервера в Timeweb сейчас нет ни одного IPv4. Создаю новый (удалять нечего)." mail
  fi
  log "[$(tw_label)] попытка $tries из $ATT_MAX: старт, старый ${old:--}"
  resp=$(api POST "/servers/$TIMEWEB_SERVER_ID/ips" '{"type":"ipv4"}')
  cand=$(jq -r '.server_ip.ip // empty' <<<"$resp" 2>/dev/null)
  if [[ -z $cand ]]; then
    tw_limit_block "$resp" || throttle "ip_err$TSUF" 3600 "[$(tw_label)] Timeweb не выдал новый IPv4: $(head -c 300 <<<"$resp")" mail
    return 2
  fi
  ip_created
  log "[$(tw_label)] кандидат $cand (за сутки создано $(ip_used_24h) из $IP_LIMIT)"
  sleep 3
  if ! ip_routed "$cand"; then
    log "[$(tw_label)] адрес $cand не проходит (трасса с homeserv обрывается) - убираю"
    api DELETE "/servers/$TIMEWEB_SERVER_ID/ips" "{\"ip\":\"$cand\"}" >/dev/null
    throttle att_fail 1800 "попытка $tries из $ATT_MAX ($(tw_label) сервер): новый адрес $cand не проходит с homeserv, убрал. Продолжаю по очереди на обоих серверах" mail
    return 1
  fi
  new=$cand
  log "[$(tw_label)] новый IPv4 $new: трасса проходит"
  announce_ip "$old" "$new" || true   # пока старый адрес ещё жив: сервер закрепит новый на eth0, даже если Timeweb не отдаст его по DHCP
  if [[ -n $old ]]; then
    resp=$(api DELETE "/servers/$TIMEWEB_SERVER_ID/ips" "{\"ip\":\"$old\"}")
    sleep 5
    if all_ipv4 | grep -qx "$old"; then
      notify "[$(tw_label)] старый IP $old не удалился ($(head -c 200 <<<"$resp")), новый $new добавлен - проверьте панель Timeweb" mail
    else
      log "[$(tw_label)] старый IPv4 $old удалён"
    fi
  fi
  sleep 20                       # даём Timeweb довести новый адрес до сервера
  do_reboot || true
  t0=$(now); up=0
  standby=0; [[ $n != "$(get active_target 1)" ]] && standby=1
  if (( standby )); then
    # неактивный сервер: рабочий туннель идёт к другому серверу и живёт - сначала проверяем новый адрес на временном
    # интерфейсе, а рабочий туннель переносим, только когда сервер уже ответил (если ещё грузится - один раз ждём дольше)
    if probe_handshake "$new" "$HS_WAIT" || { [[ $(tw_status) != on ]] && probe_handshake "$new" "$HS_WAIT_EXTRA"; }; then
      t0=$(now); tun_set_endpoint "$new"
      put keys_pending "$new"; put fails 0
      wait_new_handshake "$t0" "$HS_WAIT" && up=1      # сервер уже отвечал на проверке: здесь только перенос рабочего туннеля
    fi
  else
    tun_set_endpoint "$new"
    put keys_pending "$new"        # ключи уйдут только после нового рукопожатия
    put fails 0
    # проверка каждые 5 с и выход сразу, как туннель поднялся; если сервер ещё грузится (статус не on) - один раз ждём дольше
    if wait_new_handshake "$t0" "$HS_WAIT" || { [[ $(tw_status) != on ]] && wait_new_handshake "$t0" "$HS_WAIT_EXTRA"; }; then up=1; fi
  fi
  if (( up )); then
    put active_target "$n"; put users_pushed none; put last_mirror 0   # на новом сервере список пользователей и копию данных обновим заново
    echo "$t ${old:--} $new" >> "$STATE/rotations"
    rm -f "$STATE/att_total" "$STATE/att_next" "$STATE/last_attempt" "$STATE/thr_att_fail" "$STATE/thr_att_max"
    mail_from_mirror "$new" && rm -f "$STATE/keys_pending"
    notify "туннель поднялся через $(tw_label) сервер: IP ${old:--} → $new (новое рукопожатие), ключи разосланы" mail
    rm -f "$STATE/down_since" "$STATE"/once_*
    return 0
  fi
  echo "$t ${old:--} $new fail" >> "$STATE/rotations"
  if (( standby )); then
    throttle att_fail 1800 "попытка $tries из $ATT_MAX ($(tw_label) сервер): IP ${old:--} → $new, сервер не ответил на проверке. Рабочий туннель не трогал, ключи НЕ рассылал. Продолжаю по очереди на обоих серверах" mail
    do_reboot hard || true
    if [[ $(get keys_pending none) == "$new" ]]; then   # проверка прошла, а перенос рабочего туннеля нет - вернуть туннель на активный сервер
      rm -f "$STATE/keys_pending"
      tw_use "$(get active_target 1)" || true
      cur=$(main_ipv4); [[ -n $cur ]] && tun_set_endpoint "$cur"
    fi
    return 1
  fi
  throttle att_fail 1800 "попытка $tries из $ATT_MAX ($(tw_label) сервер): IP ${old:--} → $new, туннель за $(( $(now) - t0 )) с не поднялся - ключи НЕ рассылал (разошлю, когда связь появится). Продолжаю по очереди на обоих серверах" mail
  touch "$STATE/rotated_in_outage"
  do_reboot hard || true
  return 1
}

rotate() { # [--force] [1|2]: ручная смена IP (на активном сервере или на указанном); --force - без резерва и пауз по лимиту
  local a force="" n="" rc
  for a in "$@"; do case $a in --force) force=--force ;; 1|2) n=$a ;; esac; done
  n=${n:-$(get active_target 1)}
  attempt "$n" $force; rc=$?
  tw_use "$(get active_target 1)" || true
  return $rc
}

zebra() { # шаг «зебры» из check(): очередная попытка на очередном сервере; 0 - связь вернулась
  local t tries gap n pass rc=2 day_cnt other i cur
  local -a tg
  t=$(now); tries=$(get att_total)
  if (( tries >= ATT_MAX )); then
    throttle att_max $((24*3600)) "исчерпано $ATT_MAX попыток вернуть связь на обоих серверах Timeweb. Автоматика остановлена - нужна проверка вручную (консоль в панели Timeweb, аварийный канал работает)" mail
    return 1
  fi
  gap=$ROTATE_RETRY; (( tries >= ATT_FAST )) && gap=$ROTATE_RETRY_SLOW
  if (( t - $(get last_attempt) < gap )); then log "попытка вернуть связь: следующая через $(( gap - (t - $(get last_attempt)) )) с"; return 1; fi
  day_cnt=$(awk -v d=$((t-86400)) '$1>d && NF==3' "$STATE/rotations" 2>/dev/null | wc -l)
  if (( day_cnt >= MAX_ROT_PER_DAY )); then
    throttle rot_day $((6*3600)) "уже $MAX_ROT_PER_DAY удачных смен IP за сутки, а связи нет - нужна проверка вручную" mail
    return 1
  fi
  read -r -a tg <<<"$(tw_targets)"
  n=$(get att_next "${tg[0]}"); [[ " ${tg[*]} " == *" $n "* ]] || n=${tg[0]}
  for pass in "${tg[@]}"; do            # выбранный сервер пропустил (лимит/не on) - пробуем другой в ту же минуту
    attempt "$n"; rc=$?
    (( rc == 2 )) || break
    for i in "${!tg[@]}"; do [[ ${tg[$i]} == "$n" ]] && { n=${tg[$(( (i + 1) % ${#tg[@]} ))]}; break; }; done
  done
  if (( rc == 0 )); then tw_use "$(get active_target 1)" || true; return 0; fi
  if (( rc == 1 )); then               # попытка потрачена
    put att_total "$(( tries + 1 ))"; put last_attempt "$t"
    for i in "${!tg[@]}"; do [[ ${tg[$i]} == "$n" ]] && { other=${tg[$(( (i + 1) % ${#tg[@]} ))]}; break; }; done
    put att_next "${other:-$n}"
  fi
  tw_use "$(get active_target 1)" || true
  cur=$(main_ipv4)                     # неудачная попытка на другом сервере не должна оставлять туннель на его адресе
  [[ -n $cur ]] && tun_set_endpoint "$cur"
  return 1
}

# ---------- раскатка этого скрипта на VPN-сервер и на Бостон ----------
# Скрипт на всех серверах должен быть одним и тем же. Сторож сам отправляет свой скрипт тем, у кого он другой:
# на Бостон - по аварийному ключу, на активный VPN-сервер - по ключу users (оба с принудительной командой vampn remote,
# команда selfupdate). Сервер ставит присланный скрипт только если он целый, старый остаётся как vampn.prev.
EXPECT_EVERY=300   # адрес сервера повторно сообщается раз в 5 минут (серверу он верен 15)
DEPLOY_EVERY=600   # неудавшуюся отправку повторять не чаще раза в 10 минут
deploy_scripts() { # [force] - отправить скрипт тем, у кого он другой; force - всем заново
  local h t a out
  h=$(sha256sum "$SELF" | cut -c1-16); t=$(now); a=$(get active_target 1)
  if [[ ${1:-} == force ]]; then
    put deployed_em none; put "deployed_srv_$a" none; put deploy_try_em 0; put deploy_try_srv 0
  fi
  if [[ -f $EM_ENV && $(get deployed_em none) != "$h" ]] && (( t - $(get deploy_try_em 0) >= DEPLOY_EVERY )); then
    put deploy_try_em "$t"
    if em_init && out=$(em_ssh selfupdate < "$SELF" 2>&1); then
      put deployed_em "$h"; log "Бостон: скрипт обновлён ($out)"
    else
      log "Бостон: скрипт не обновлён: $(tail -c 150 <<<"${out:-}")"
    fi
  fi
  if [[ $(get "deployed_srv_$a" none) != "$h" ]] && (( t - $(get deploy_try_srv 0) >= DEPLOY_EVERY )) && alive; then
    put deploy_try_srv "$t"
    if out=$("${SSH_SRV[@]}" -i /etc/vampn/users.key root@$SRV_TIP selfupdate < "$SELF" 2>&1); then
      put "deployed_srv_$a" "$h"; log "VPN-сервер ($(tw_label)): скрипт обновлён ($out)"
    else
      log "VPN-сервер ($(tw_label)): скрипт не обновлён: $(tail -c 150 <<<"$out")"
    fi
  fi
}

check() {
  exec 9>"$STATE/lock"; flock -n 9 || exit 0
  local fails st cur t
  tw_use "$(get active_target 1)" || tw_use 1
  em_active || tun_keep_endpoint
  deploy_scripts
  if em_active; then
    em_init
    ip link show "$EM_IFACE" >/dev/null 2>&1 || { log "туннель до Бостона пропал - поднимаю"; em_tunnel_up; }
    if alive; then    # Timeweb снова отвечает: 3 минуты подряд - возвращаемся
      put em_ok $(( $(get em_ok) + 1 ))
      log "аварийный режим: Timeweb отвечает ($(get em_ok)/3)"
      (( $(get em_ok) >= 3 )) && emergency_off
      return 0          # пока трафик идёт через Бостон, данные пользователей не трогаем
    fi
    put em_ok 0
  fi
  if alive; then
    if [[ -f $STATE/down_since ]]; then
      if compgen -G "$STATE/once_*" >/dev/null || [[ -f $STATE/rotated_in_outage ]]; then
        notify "связь с сервером восстановилась (простой $(( ($(now) - $(get down_since)) / 60 )) мин)" mail
      else
        log "связь восстановилась после короткого сбоя"
      fi
      rm -f "$STATE/down_since" "$STATE"/once_* "$STATE/rotated_in_outage"
    fi
    put fails 0
    rm -f "$STATE/att_total" "$STATE/att_next" "$STATE/last_attempt" "$STATE/thr_att_fail" "$STATE/thr_att_max"
    if [[ -s $STATE/keys_pending && -f $MIRROR/server.env ]]; then   # ключи ждали живого туннеля
      local pend; pend=$(get keys_pending)
      if [[ $pend == "$(tun_endpoint)" ]]; then mail_from_mirror "$pend" && rm -f "$STATE/keys_pending"; else rm -f "$STATE/keys_pending"; fi
    fi
    push_users
    push_expect >/dev/null 2>&1 || true
    (( $(now) - $(get last_mirror) >= MIRROR_EVERY )) && pull_mirror
    return 0
  fi
  inet_ok || { log "нет интернета у homeserv - пропуск"; return 0; }
  cur=$(main_ipv4)   # IP могли сменить вручную в панели - просто подтягиваем
  if [[ -n $cur && $cur != "$(tun_endpoint)" ]]; then tun_set_endpoint "$cur"; put keys_pending "$cur"; return 0; fi
  fails=$(( $(get fails) + 1 )); put fails "$fails"
  [[ -f $STATE/down_since ]] || put down_since "$(now)"
  log "туннель мёртв (рукопожатие $(hs_age) с назад), минут без связи: $fails"
  (( fails < REBOOT_AT )) && return 0
  em_active || once em_offer "основной сервер (Timeweb) недоступен $fails мин. Пробую перезагрузить его, потом сменить IP (по очереди на основном и запасном серверах). Через $EM_AT мин без связи аварийный канал (Бостон) включится сам"
  if (( fails >= EM_AT )) && ! em_active && [[ -f $EM_ENV && -f $MIRROR/server.env && ! -f $STATE/once_em_auto ]]; then
    touch "$STATE/once_em_auto"        # одна попытка на аварию (флаг снимается, когда связь вернулась)
    log "без связи $fails мин - включаю аварийный канал сам"
    emergency_on || true
  fi
  st=$(tw_status); t=$(now)
  case $st in
    on) ;;
    off|stopped)
      if (( t - $(get "last_start$TSUF") >= REBOOT_GAP )); then
        once start "сервер выключен (статус $st) - включаю"
        log "включаю сервер (статус $st)"
        api POST "/servers/$TIMEWEB_SERVER_ID/action" '{"action":"start"}' >/dev/null; put "last_start$TSUF" "$t"
      fi ;;
    *) once status "сервер недоступен, статус в Timeweb: $st - жду" ;;
  esac
  if (( fails >= ROTATE_AT )) && zebra; then return 0; fi
  [[ $st == on ]] || return 0          # перезагружаем только сервер, который Timeweb считает включённым
  if (( t - $(get last_reboot) >= REBOOT_GAP )); then
    # о перезагрузке уже предупредило сообщение em_offer выше - тут только журнал
    log "перезагрузка: без связи $fails мин"
    do_reboot || true
  fi
}

status() {
  echo "туннель      : рукопожатие $(hs_age) с назад ($(probe_tunnel 1 && echo 'сервер отвечает через туннель' || echo 'ответа через туннель нет'); мёртв, если рукопожатие > $HS_FRESH с и ответа нет)"
  echo "сервер       : $(tun_endpoint):$(tun_port)"
  local n act; act=$(get active_target 1)
  for n in $(tw_targets); do   # подоболочка: tw_use меняет TARGET/TSUF и доступы только внутри неё
    ( tw_use "$n" 2>/dev/null && echo "Timeweb ($(tw_label)$([[ $n == "$act" ]] && echo ', активный')): статус $(tw_status), IPv4 $(all_ipv4 | tr '\n' ' '), новых IP за сутки $(ip_used_24h) из $IP_LIMIT$({ rot_blocked || rot_paused; } && echo "; смена IP на паузе до $(TZ=Europe/Moscow date -d @"$(rot_wait_until)" '+%d.%m %H:%M') МСК")" )
  done
  echo "без связи    : $(get fails) мин (перезагрузка с $REBOOT_AT, смена IP с $ROTATE_AT), попыток вернуть связь $(get att_total) из $ATT_MAX"
  echo "аварийный    : $(em_active && echo "ВКЛЮЧЁН - трафик через Бостон" || echo "выключен")"
  local lm; lm=$(get last_mirror)
  echo "копия данных : $( ((lm)) && date -d @"$lm" '+%F %T' || echo нет), пользователей $(ls "$MIRROR"/clients/*.env 2>/dev/null | wc -l)"
  echo "смены IP     :"; { tail -5 "$STATE/rotations" 2>/dev/null || true; } | while read -r t o n; do echo "  $(date -d @"$t" '+%F %T') $o -> $n"; done
  echo "журнал       :"; { tail -6 "$STATE/vampn.log" 2>/dev/null || true; } | sed 's/^/  /'
}

# ---------- надёжность рассылки ключей ----------
# Журнал $STATE/mail-status.tsv пишет почтовая часть: время, имя, адрес, вид (key|notice), ok|fail, подробности.
# ok значит «SMTP-сервер принял письмо»; дошло ли оно до ящика, он не сообщает (письмо могло уйти в спам).
MAILLOG=$STATE/mail-status.tsv
USERS_CONF=/etc/vampn/users.conf   # на деле его выставляет users_conf_file (файл ячейки)
MAIL_RETRY_AFTER=600     # повтор неудачной отправки не раньше, чем через 10 мин
MAIL_RETRY_MAX=3         # сколько раз сторож сам пробует ещё

mail_failed() {   # у кого ПОСЛЕДНЯЯ отправка ключа не удалась: имя<TAB>время<TAB>подробности
  [[ -s $MAILLOG ]] || return 0
  awk -F'\t' '$4=="key" && $2!="" {s[$2]=$5; t[$2]=$1; d[$2]=$6} END{for(n in s) if(s[n]=="fail") print n "\t" t[n] "\t" d[n]}' "$MAILLOG" | sort
}

mail_watch() {    # сторож: неудачные письма с ключом повторяет сам, один раз сообщает в Telegram
  exec 8>"$STATE/mail.lock"; flock -n 8 || return 0
  local failed names new n ts det cnt
  failed=$(mail_failed)
  if [[ -z $failed ]]; then rm -f "$STATE/mail_alerted" "$STATE"/mail_retry_* "$STATE"/mail_gaveup_*; return 0; fi
  names=$(cut -f1 <<<"$failed" | tr '\n' ' '); names=${names% }
  new=$(comm -13 <(tr ' ' '\n' <<<"$(cat "$STATE/mail_alerted" 2>/dev/null)" | sort) <(tr ' ' '\n' <<<"$names" | sort) | tr '\n' ' '); new=${new% }
  put mail_alerted "$names"
  [[ -n $new ]] && notify "письмо с ключом не ушло: $new. Сторож повторит сам (до $MAIL_RETRY_MAX раз), список: vampn mailstatus"
  em_active && return 0
  [[ -f $MIRROR/server.env && $(cat "$MIRROR/endpoint" 2>/dev/null) == "$(tun_endpoint)" ]] || return 0
  while IFS=$'\t' read -r n ts det; do
    [[ -n $n ]] || continue
    cnt=$(get "mail_retry_$n")
    if (( cnt >= MAIL_RETRY_MAX )); then
      if [[ ! -f $STATE/mail_gaveup_$n ]]; then
        touch "$STATE/mail_gaveup_$n"
        notify "ключ для $n не ушёл и после $MAIL_RETRY_MAX повторов ($det). Проверьте адрес в users.conf или пароль почты, потом vampn resendall"
      fi
      continue
    fi
    (( $(now) - ts >= MAIL_RETRY_AFTER )) || continue
    put "mail_retry_$n" $(( cnt + 1 ))
    if VAMPN_BASE=$MIRROR "$SELF" mailsend "$n" </dev/null >>"$STATE/vampn.log" 2>&1; then
      log "повтор ключа $n: ушёл"; rm -f "$STATE/mail_retry_$n" "$STATE/mail_gaveup_$n"
    else
      log "повтор ключа $n: опять не ушёл ($(( cnt + 1 ))/$MAIL_RETRY_MAX)"
    fi
    break             # одно письмо за проверку: сторож не должен надолго занимать таймер
  done <<<"$failed"
}

resend_all() {    # vampn resendall: текущий ключ всем из users.conf, неушедшим - ещё раз, итог и тревога
  exec 8>"$STATE/mail.lock"; flock -w 300 8
  em_active && die "сейчас аварийный режим: ключи основного сервера не рассылаю. Сначала vampn emergency off"
  [[ -f $MIRROR/server.env ]] || die "нет копии данных VPN-сервера ($MIRROR): рассылать нечего (vampn mirror)"
  pull_mirror >/dev/null 2>&1 || true
  local mep tep; mep=$(cat "$MIRROR/endpoint" 2>/dev/null); tep=$(tun_endpoint)
  [[ $mep == "$tep" ]] || die "адрес в копии данных ($mep) не совпал с туннелем ($tep): ключи с неверным адресом не рассылаю (vampn status)"
  local -a todo=() bad=()
  USERS_CONF=$(users_conf_file) || die "нет /etc/vampn/users.conf"
  mapfile -t todo < <(awk '!/^[[:space:]]*#/ && NF>=2 {print $1}' "$USERS_CONF")
  local total=${#todo[@]} ok=0 n pass
  (( total )) || die "в $USERS_CONF нет пользователей"
  for pass in 1 2; do
    bad=()
    for n in "${todo[@]}"; do
      if VAMPN_BASE=$MIRROR "$SELF" mailsend "$n" </dev/null >>"$STATE/vampn.log" 2>&1; then
        echo "  $n: принято почтовым сервером"; ok=$(( ok + 1 ))
      else
        echo "  $n: НЕ УШЛО"; bad+=("$n")
      fi
    done
    (( ${#bad[@]} )) || break
    if (( pass == 1 )); then echo "повторяю неушедшие через 60 с: ${bad[*]}"; sleep 60; todo=("${bad[@]}"); fi
  done
  if (( ${#bad[@]} )); then
    notify "рассылка ключей: принято $ok из $total, НЕ ушло: ${bad[*]}. Подробности: vampn mailstatus"
    echo "ИТОГ: принято $ok из $total, не ушло: ${bad[*]}"
    return 1
  fi
  log "рассылка ключей всем: принято $ok из $total"
  echo "ИТОГ: принято $ok из $total"
}

key_local() {     # link|conf ИМЯ - из копии данных на homeserv, если она сходится с туннелем (VPN-сервер может не отвечать)
  local what=$1 n=${2:-}
  [[ $n =~ ^[a-zA-Z0-9_.-]{1,32}$ ]] || die "нужно имя пользователя: vampn $what ИМЯ"
  em_active && die "сейчас аварийный режим: основной сервер недоступен, эта команда работает с ним"
  [[ -f $MIRROR/clients/$n.env && $(cat "$MIRROR/endpoint" 2>/dev/null) == "$(tun_endpoint)" ]] || return 1
  case $what in
    link) VAMPN_BASE=$MIRROR "$SELF" mailsend --link "$n" ;;
    conf) VAMPN_BASE=$MIRROR "$SELF" conf "$n" ;;
  esac
}

cell_state() { # номер -> каталог состояния ячейки (журнал отправки писем и т.п.)
  if (( $1 == CELL )); then echo "$STATE"
  elif (( $1 == 1 )); then echo /var/lib/vampn
  else echo "${VAMPN_CELLS_STATE:-/var/lib/vampn/cells}/$1"; fi
}

mailstatus() {    # vampn mailstatus: по каждому из users.conf (всех ячеек) - последняя отправка ключа
  local n em c last ts st det bad=0 line src=${VAMPN_USERS:-/etc/vampn/users.conf}
  [[ -f $src ]] || die "нет /etc/vampn/users.conf"
  printf '%-14s %-7s %-34s %-12s %s\n' ИМЯ ЯЧЕЙКА ПОЧТА ПОСЛЕДНЯЯ ИТОГ
  while read -r n em c; do
    [[ -z $n ]] && continue
    last=$(awk -F'\t' -v n="$n" '$4=="key" && $2==n {l=$0} END{print l}' "$(cell_state "$c")/mail-status.tsv" 2>/dev/null)
    if [[ -z $last ]]; then printf '%-14s %-7s %-34s %-12s %s\n' "$n" "$c" "$em" - "нет записи (письмо ушло до журнала)"; continue; fi
    IFS=$'\t' read -r ts _ _ _ st det <<<"$last"
    if [[ $st == ok ]]; then line="принято почтовым сервером"; else line="НЕ УШЛО: $det"; bad=$(( bad + 1 )); fi
    printf '%-14s %-7s %-34s %-12s %s\n' "$n" "$c" "$em" "$(date -d "@$ts" '+%d.%m %H:%M')" "$line"
  done < <(sed 's/\r$//' "$src" | awk '/^[[:space:]]*#/ || NF < 2 {next} {print $1, $2, (NF >= 3 && $3 ~ /^[0-9]+$/) ? $3 + 0 : 1}')
  echo
  echo "«принято» - почтовый сервер взял письмо; дойдёт ли оно до ящика (не спам ли), он не сообщает."
  echo "Ключ всегда можно получить и в приложении vampn по логину. Отправить всем заново: vampn resendall"
  (( bad )) && return 1 || return 0
}

# ====================================================================================================
# Ячейки и аренда серверов (только homeserv, только админ: команды в sudoers API доступны лишь роли admin).
#   vampn cells                        таблица ячеек: номер, имя, IP, пользователи/лимит, возраст рукопожатия, состояние
#   vampn account add ИМЯ              добавить кабинет Timeweb: токен API читается из stdin (в аргументах и журналах его нет)
#   vampn account list|del ИМЯ         кабинеты (без токенов) / убрать кабинет (если им не пользуется ни одна ячейка)
#   vampn spawn [КАБИНЕТ]              арендовать самый дешёвый сервер в Амстердаме (Debian) под именем vampn_N, развернуть install.sh,
#                                      поднять туннель и сторожа новой ячейки; идёт в фоне, ход - vampn spawnstatus
#   vampn spawnresume N               продолжить развёртывание на уже созданном сервере ячейки N (если spawn упал, а сервер остался)
#   vampn spawnstatus [ЧИСЛО строк]   состояние и журнал последнего запуска spawn
#   vampn celldel N --yes [--force]   удалить ячейку и её сервер в Timeweb (отказ, пока в ячейке есть пользователи, без --force)
# Лимитов по деньгам нет (так решено): выбирается самый дешёвый тариф локации nl-1 (Amsterdam) и образ Debian 13 (или новее 12).
# ====================================================================================================
ETC_DIR=${VAMPN_ETC:-/etc/vampn}
CELLS_DIR=$ETC_DIR/cells ACCT_DIR=$ETC_DIR/accounts
SPAWN_DIR=${VAMPN_SPAWN_DIR:-/var/lib/vampn/spawn}
SPAWN_LOC=nl-1 SPAWN_ZONE=ams-1   # ячейка N>=2: туннель и клиенты 10.77.(4*(N-1)).0/22; ключ spawn.key - ssh на новые серверы
twa() { # ТОКЕН МЕТОД ПУТЬ [ТЕЛО] - вызов API Timeweb от имени кабинета (не трогает глобальный TIMEWEB_TOKEN)
  curl -sS -m 40 -X "$2" -H "Authorization: Bearer $1" -H 'Content-Type: application/json' ${4:+-d "$4"} "$API$3"
}
valid_acct() { [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,23}$ ]] || die "имя кабинета: латиница в нижнем регистре, цифры, _ - (до 24 знаков)"; }
acct_file() { # имя кабинета -> файл с TIMEWEB_TOKEN. main и spare - прежние timeweb.env и timeweb2.env
  case $1 in
    main|1)  echo "$ETC_DIR/timeweb.env" ;;
    spare|2) echo "$ETC_DIR/timeweb2.env" ;;
    *)       valid_acct "$1"; echo "$ACCT_DIR/$1.env" ;;
  esac
}
acct_names() { [[ -f $ETC_DIR/timeweb.env ]] && echo main; [[ -f $ETC_DIR/timeweb2.env ]] && echo spare
  local f; for f in "$ACCT_DIR"/*.env; do [[ -f $f ]] && basename "$f" .env; done; true; }
acct_token() { local f; f=$(acct_file "$1") && [[ -f $f ]] || return 1; ( set -a; . "$f"; set +a; echo "${TIMEWEB_TOKEN:-}" ); }
acct_default() { local d f; d=$(cat "$ACCT_DIR/default" 2>/dev/null)
  if [[ $d =~ ^[a-z0-9][a-z0-9_-]{0,23}$ ]]; then f=$(acct_file "$d"); [[ -f $f ]] && { echo "$d"; return; }; fi
  echo main; }

account_main() {
  local sub=${1:-list} name=${2:-} tok f resp
  case $sub in
    add)
      valid_acct "$name"; [[ $name =~ ^(main|spare)$ ]] && die "имена main и spare заняты прежними кабинетами"
      IFS= read -r tok || true; tok=${tok//[[:space:]]/}
      [[ ${#tok} -ge 20 && $tok =~ ^[A-Za-z0-9._-]+$ ]] || die "на stdin нужен токен API Timeweb (одной строкой)"
      resp=$(twa "$tok" GET /account/finances) || die "Timeweb не ответил"
      jq -e '.finances' >/dev/null 2>&1 <<<"$resp" || die "Timeweb не принял токен: $(jq -r '.message // .error_code // "нет ответа"' <<<"$resp" 2>/dev/null)"
      install -d -m 700 "$ACCT_DIR"; f=$ACCT_DIR/$name.env
      ( umask 077; printf '# кабинет Timeweb %s (добавлен %s)\nTIMEWEB_TOKEN=%s\n' "$name" "$(date -Iseconds)" "$tok" > "$f" )
      [[ -f $ACCT_DIR/default ]] || echo "$name" > "$ACCT_DIR/default"
      echo "кабинет $name добавлен: баланс $(jq -r '.finances.balance' <<<"$resp") $(jq -r '.finances.currency' <<<"$resp")" ;;
    list)
      local n t r def tsv=0; def=$(acct_default); [[ ${name:-} == --tsv ]] && tsv=1
      if (( tsv )); then   # для API: имя, состояние (ok|denied|none), баланс, валюта, по умолчанию (1/0), сообщение - через табуляцию, без токенов
        for n in $(acct_names); do
          t=$(acct_token "$n") || t=""
          if [[ -z $t ]]; then printf '%s\tnone\t\t\t0\t\n' "$n"; continue; fi
          r=$(twa "$t" GET /account/finances 2>/dev/null)
          if jq -e '.finances' >/dev/null 2>&1 <<<"$r"; then printf '%s\tok\t%s\t%s\t%s\t\n' "$n" "$(jq -r '.finances.balance' <<<"$r")" "$(jq -r '.finances.currency' <<<"$r")" "$([[ $n == "$def" ]] && echo 1 || echo 0)"
          else printf '%s\tdenied\t\t\t%s\t%s\n' "$n" "$([[ $n == "$def" ]] && echo 1 || echo 0)" "$(jq -r '.message // "нет ответа"' <<<"$r" 2>/dev/null | tr '\t\n' '  ')"; fi
        done
        return 0
      fi
      printf '%-12s %-9s %s\n' КАБИНЕТ ТОКЕН СЕРВЕРОВ/БАЛАНС
      for n in $(acct_names); do
        t=$(acct_token "$n") || t=""
        if [[ -z $t ]]; then printf '%-12s %-9s\n' "$n" нет; continue; fi
        r=$(twa "$t" GET /account/finances 2>/dev/null)
        if jq -e '.finances' >/dev/null 2>&1 <<<"$r"; then printf '%-12s %-9s %s %s%s\n' "$n" принят "$(jq -r '.finances.balance' <<<"$r")" "$(jq -r '.finances.currency' <<<"$r")" "$([[ $n == "$def" ]] && echo '  (по умолчанию)')"
        else printf '%-12s %-9s %s\n' "$n" ОТКАЗ "$(jq -r '.message // "нет ответа"' <<<"$r" 2>/dev/null)"; fi
      done ;;
    default) acct_file "$name" >/dev/null; [[ -f $(acct_file "$name") ]] || die "нет кабинета $name"; echo "$name" > "$ACCT_DIR/default"; echo "по умолчанию: $name" ;;
    del)
      valid_acct "$name"; f=$ACCT_DIR/$name.env; [[ -f $f ]] || die "нет кабинета $name"
      grep -qx "CELL_ACCOUNT=$name" "$CELLS_DIR"/*.env 2>/dev/null && die "кабинетом $name пользуется ячейка: сначала vampn celldel"
      rm -f "$f"; [[ $(cat "$ACCT_DIR/default" 2>/dev/null) == "$name" ]] && rm -f "$ACCT_DIR/default"
      echo "кабинет $name убран" ;;
    *) die "vampn account add ИМЯ (токен на stdin) | list | default ИМЯ | del ИМЯ" ;;
  esac
}

cell_ids() { { echo 1; for f in "$CELLS_DIR"/*.env; do [[ -f $f ]] && basename "$f" .env; done; } | grep -E '^[0-9]+$' | sort -n | uniq; }
cell_users() { # номер -> сколько пользователей в users.conf относится к ячейке
  awk -v c="$1" '/^[[:space:]]*#/ || NF==0 {next} { cc=(NF==3 && $3 ~ /^[0-9]+$/) ? $3+0 : 1; if (cc==c) n++ } END{print n+0}' "${VAMPN_USERS:-/etc/vampn/users.conf}" 2>/dev/null || echo 0
}
cell_field() { # номер поле -> значение из cells/N.env (для ячейки 1 - из настроек по умолчанию)
  local n=$1 k=$2
  if [[ $n == 1 ]]; then case $k in CELL_NAME) echo vampn ;; CELL_LIMIT) echo 1000 ;; CELL_NET) echo 10.77.0 ;; esac; return; fi
  ( . "$CELLS_DIR/$n.env" 2>/dev/null; eval "echo \"\${$k:-}\"" )
}
cells_main() { # таблица для людей и для API: поля через табуляцию
  local n ip name lim us hs st
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' ЯЧЕЙКА ИМЯ IP ПОЛЬЗОВАТЕЛЕЙ ЛИМИТ РУКОПОЖАТИЕ СОСТОЯНИЕ
  for n in $(cell_ids); do
    name=$(cell_field "$n" CELL_NAME); lim=$(cell_field "$n" CELL_LIMIT); us=$(cell_users "$n")
    if [[ $n == 1 ]]; then ip=$(awk -F'[ =:]+' '/^Endpoint/{print $2}' /etc/amnezia/amneziawg/vampn.conf 2>/dev/null); st=активна
      hs=$(awg show vampn latest-handshakes 2>/dev/null | awk '{print $2; exit}')
    else ip=$(cell_field "$n" CELL_IP); st=$(cell_field "$n" CELL_STATE)
      hs=$(awg show "vampn$n" latest-handshakes 2>/dev/null | awk '{print $2; exit}'); fi
    [[ $hs =~ ^[0-9]+$ && $hs -gt 0 ]] && hs=$(( $(now) - hs ))s || hs=-
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "${name:-vampn_$n}" "${ip:--}" "$us" "${lim:-1000}" "$hs" "${st:-?}"
  done
}

SPAWN_STEP=""
sp_log() { echo "$(date '+%F %T') $*" >> "$SPAWN_DIR/job.log"; }
sp_step() { SPAWN_STEP=$1; echo "running: $1" > "$SPAWN_DIR/job.state"; sp_log "$1"; }
sp_fail() { echo "failed: ${SPAWN_STEP:-?}: $*" > "$SPAWN_DIR/job.state"; sp_log "ОШИБКА на шаге «${SPAWN_STEP:-?}»: $*"
  [[ -n ${SPAWN_CELL:-} && -f $CELLS_DIR/$SPAWN_CELL.env ]] && sed -i 's/^CELL_STATE=.*/CELL_STATE=ошибка/' "$CELLS_DIR/$SPAWN_CELL.env"
  [[ -n ${SPAWN_CELL:-} ]] && echo "$SPAWN_CELL" > "$SPAWN_DIR/last_cell"
  if [[ -n ${SPAWN_AUTO:-} && -n ${SPAWN_CELL:-} ]]; then
    sp_notify "развёртывание не удалось на шаге «${SPAWN_STEP:-?}»: $*. Сервер ячейки $SPAWN_CELL нерабочий - удаляю его"
  else
    sp_notify "аренда сервера не удалась на шаге «${SPAWN_STEP:-?}»: $*${SPAWN_CELL:+. Ячейка $SPAWN_CELL и сервер в Timeweb оставлены для разбора (vampn spawnstatus, vampn celldel $SPAWN_CELL --yes)}"
  fi
  exit 1; }
sp_notify() { # Telegram и письмо без обращения к состоянию какой-либо ячейки
  tg notify alerts "🛡 $1" >/dev/null 2>&1 || true
  printf '%s\n' "$1" | mailpy --alert "$1" >/dev/null 2>&1 || true
}

spawn_pick() { # ТОКЕН -> "preset_id os_id" или ошибка
  local tok=$1 presets oss preset os
  presets=$(twa "$tok" GET /presets/servers) || return 1
  preset=$(jq -r --arg loc "$SPAWN_LOC" '[.server_presets[]? | select(.location == $loc)] | sort_by(.price, .id) | .[0].id // empty' <<<"$presets")
  [[ -n $preset ]] || { echo "в локации $SPAWN_LOC нет тарифов"; return 1; }
  oss=$(twa "$tok" GET /os/servers) || return 1
  os=$(jq -r '[.servers_os[]? | select(.name == "debian" and (.version | tonumber? // 0) >= 12)] | sort_by(.version | tonumber) | reverse | .[0].id // empty' <<<"$oss")
  [[ -n $os ]] || { echo "нет образа Debian 12/13"; return 1; }
  echo "$preset $os"
}

sp_udp_check() { # IP - доходит ли UDP от homeserv до сервера и обратно (часть адресов Timeweb режется по пути: туннель на таком не поднимется, а ставить на него бессмысленно)
  local ip=$1 port=45331 srvpid rc
  "${ssh[@]}" "root@$ip" "python3 - $port" >/dev/null 2>&1 <<'PY' &
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.bind(("0.0.0.0", int(sys.argv[1]))); s.settimeout(45)
try:
    while True:
        d, a = s.recvfrom(100); s.sendto(b"ok", a)
except Exception:
    pass
PY
  srvpid=$!
  sleep ${SPAWN_RETRY_WAIT:-5}
  python3 - "$ip" "$port" <<'PY'
import socket, sys, time
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(1)
end = time.time() + 30
while time.time() < end:
    s.sendto(b"ping", (sys.argv[1], int(sys.argv[2])))
    try:
        d, a = s.recvfrom(100)
        if d == b"ok": sys.exit(0)
    except socket.timeout:
        pass
sys.exit(1)
PY
  rc=$?
  kill $srvpid 2>/dev/null; wait $srvpid 2>/dev/null
  return $rc
}

spawn_run() { # КАБИНЕТ - сама аренда и развёртывание (в фоне)
  local acct=$1 tok n name net preset os keyid pub resp sid ip st i ssh key_root home_pub out port pubkey relay_pub tmp pay
  SPAWN_CELL=""
  install -d -m 700 "$SPAWN_DIR" "$CELLS_DIR"
  exec 7>"$SPAWN_DIR/lock"; flock -n 7 || { echo "уже идёт другая аренда" >&2; exit 1; }
  [[ -n ${SPAWN_KEEPLOG:-} ]] || : > "$SPAWN_DIR/job.log"
  if [[ -n ${SPAWN_RESUME:-} ]]; then
    # продолжить на уже созданном сервере ячейки N (прошлый запуск упал, например на ожидании ssh): сервер не создаём
    n=$SPAWN_RESUME; SPAWN_CELL=$n
    sp_step "продолжение: ячейка $n"
    [[ $n =~ ^[0-9]+$ && -f $CELLS_DIR/$n.env && -f $CELLS_DIR/$n.timeweb.env ]] || sp_fail "нет ячейки $n для продолжения"
    name=$(sed -n 's/^CELL_NAME=//p' "$CELLS_DIR/$n.env"); net=$(sed -n 's/^CELL_NET=//p' "$CELLS_DIR/$n.env")
    ip=$(sed -n 's/^CELL_IP=//p' "$CELLS_DIR/$n.env")
    tok=$(sed -n 's/^TIMEWEB_TOKEN=//p' "$CELLS_DIR/$n.timeweb.env"); sid=$(sed -n 's/^TIMEWEB_SERVER_ID=//p' "$CELLS_DIR/$n.timeweb.env")
    [[ -n $name && -n $net && -n $tok && -n $sid ]] || sp_fail "в файлах ячейки $n не хватает данных"
    resp=$(twa "$tok" GET "/servers/$sid" 2>/dev/null) || true
    st=$(jq -r '[.server.networks[]?.ips[]? | select(.type == "ipv4")] | (map(select(.is_main)) + .)[0].ip // empty' <<<"$resp" 2>/dev/null)
    [[ -n $st ]] && ip=$st
    [[ -n $ip ]] || sp_fail "у сервера ячейки $n нет IPv4"
    sed -i "s|^CELL_IP=.*|CELL_IP=$ip|; s/^CELL_STATE=.*/CELL_STATE=создаётся/" "$CELLS_DIR/$n.env"
    sp_log "ячейка $n, сервер $name (id $sid), IPv4 $ip, сеть $net.0/22"
  elif [[ -n ${SPAWN_ADOPT:-} ]]; then
    # усыновление: сервер уже поднят командой vampn init (сам по себе), здесь он становится ячейкой homeserv
    local kh="$SPAWN_DIR/adopt.known_hosts" senv sub third a limit hn
    ip=$SPAWN_ADOPT; : > "$kh"
    sp_step "усыновление: читаю настройки сервера $ip"
    local -a ssh0=(ssh -T -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=3 -o IdentitiesOnly=yes
                   -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$kh" -i "$ETC_DIR/spawn.key")
    senv=$("${ssh0[@]}" "root@$ip" 'cat /root/vampn/server.env' </dev/null 2>/dev/null) || sp_fail "не вхожу на $ip по ключу homeserv или на нём нет /root/vampn (vampn init)"
    sub=$(sed -n 's/^SUBNET=//p' <<<"$senv"); limit=$(sed -n 's/^CLIENT_LIMIT=//p' <<<"$senv"); [[ $limit =~ ^[0-9]+$ ]] || limit=1000
    [[ $sub =~ ^10\.77\.([0-9]+)$ ]] || sp_fail "сеть сервера «$sub» не из 10.77.x.0/22"
    third=${BASH_REMATCH[1]}
    (( third >= 4 && third <= 252 && third % 4 == 0 )) || sp_fail "сеть $sub.0/22 не подходит для ячейки (нужна 10.77.4, 10.77.8, ...): на сервере vampn init --net 10.77.8"
    n=$(( third / 4 + 1 )); net=$sub
    if [[ -f $CELLS_DIR/$n.env ]]; then
      grep -qx 'CELL_ADOPTED=1' "$CELLS_DIR/$n.env" && ! grep -qx 'CELL_STATE=активна' "$CELLS_DIR/$n.env" \
        || sp_fail "ячейка $n уже есть (сеть $net.0/22 занята): на новом сервере vampn init --net 10.77.$(( 4 * (n) )) и снова vampn adopt"
    fi
    SPAWN_CELL=$n
    hn=$("${ssh0[@]}" "root@$ip" hostname </dev/null 2>/dev/null | head -1); [[ $hn =~ ^[a-zA-Z0-9_.-]{1,40}$ ]] && name=$hn || name=vampn_$n
    # сторожу ячейки нужен доступ к серверу в Timeweb (смена IP): ищем сервер с этим адресом в кабинетах
    sid=""; acct=""
    for a in $(acct_names); do
      tok=$(acct_token "$a") || continue; [[ -n $tok ]] || continue
      sid=$(twa "$tok" GET /servers 2>/dev/null | jq -r --arg ip "$ip" '[.servers[]? | select(any(.networks[]?.ips[]?; .ip == $ip))] | .[0].id // empty' 2>/dev/null)
      [[ -n $sid ]] && { acct=$a; break; }
    done
    [[ -n $sid ]] || sp_fail "сервер с адресом $ip не найден в кабинетах Timeweb ($(acct_names | tr '\n' ' ')): сторожу ячейки нужен его id (vampn account add)"
    ( umask 077; printf 'CELL_NAME=%s\nCELL_NET=%s\nCELL_LIMIT=%s\nCELL_ACCOUNT=%s\nCELL_SERVER_ID=%s\nCELL_IP=%s\nCELL_STATE=создаётся\nCELL_CREATED=%s\nCELL_ADOPTED=1\n' \
        "$name" "$net" "$limit" "$acct" "$sid" "$ip" "$(date -Iseconds)" > "$CELLS_DIR/$n.env"
      printf 'TIMEWEB_TOKEN=%s\nTIMEWEB_SERVER_ID=%s\n' "$tok" "$sid" > "$CELLS_DIR/$n.timeweb.env" )
    cp "$kh" "$CELLS_DIR/$n.known_hosts_public"
    sp_log "ячейка $n, сервер $name (id $sid, кабинет $acct), IPv4 $ip, сеть $net.0/22"
  else
  sp_step "проверка кабинета $acct"
  tok=$(acct_token "$acct") && [[ -n $tok ]] || sp_fail "нет токена кабинета $acct (vampn account add)"
  twa "$tok" GET /account/finances | jq -e '.finances' >/dev/null 2>&1 || sp_fail "Timeweb не принял токен кабинета $acct"

  sp_step "номер ячейки и тариф"
  n=1; for i in $(cell_ids); do (( i >= n )) && n=$(( i + 1 )); done
  local names; names=$(twa "$tok" GET /servers | jq -r '.servers[]?.name' 2>/dev/null)
  while grep -qx "vampn_$n" <<<"$names"; do n=$(( n + 1 )); done
  (( n <= 64 )) || sp_fail "слишком много ячеек (сети 10.77.x.0/22 кончаются на 64-й)"
  name=vampn_$n; net=10.77.$(( 4 * (n - 1) ))   # у каждой ячейки свой /22 внутри 10.77.0.0/16: ячейка 1 - 10.77.0.0/22, 2 - 10.77.4.0/22, 3 - 10.77.8.0/22...
  out=$(spawn_pick "$tok") || sp_fail "$out"
  read -r preset os <<<"$out"
  sp_log "ячейка $n, имя $name, сеть $net.0/22, тариф $preset ($SPAWN_LOC, самый дешёвый), образ Debian id=$os"

  sp_step "ключ ssh для новых серверов"
  [[ -f $ETC_DIR/spawn.key ]] || ssh-keygen -q -t ed25519 -N '' -C vampn-spawn -f "$ETC_DIR/spawn.key" || sp_fail "не удалось создать ключ ssh для новых серверов"
  pub=$(awk '{print $1, $2}' "$ETC_DIR/spawn.key.pub" 2>/dev/null)
  [[ $pub == ssh-* ]] || sp_fail "ключ ssh для новых серверов пустой или повреждён ($ETC_DIR/spawn.key.pub)"
  keyid=$(twa "$tok" GET /ssh-keys | jq -r --arg b "$pub" '[.ssh_keys[]? | select((.body | split(" ") | .[0:2] | join(" ")) == $b)] | .[0].id // empty')
  if [[ -z $keyid ]]; then
    resp=$(twa "$tok" POST /ssh-keys "$(jq -n --arg b "$pub vampn-spawn" '{name:"vampn-homeserv", body:$b, is_default:false}')")
    keyid=$(jq -r '.ssh_key.id // empty' <<<"$resp"); [[ -n $keyid ]] || sp_fail "Timeweb не принял ключ ssh: $(jq -r '.message // "?"' <<<"$resp")"
  fi

  sp_step "создание сервера $name"
  resp=$(twa "$tok" POST /servers "$(jq -n --arg name "$name" --argjson p "$preset" --argjson os "$os" --argjson k "$keyid" --arg z "$SPAWN_ZONE" \
        '{name:$name, preset_id:$p, os_id:$os, availability_zone:$z, ssh_keys_ids:[$k], is_ddos_guard:false, comment:"vampn: ячейка (создан сторожем)"}')")
  sid=$(jq -r '.server.id // empty' <<<"$resp"); [[ -n $sid ]] || sp_fail "Timeweb не создал сервер: $(jq -r '.message // .error_code // "?"' <<<"$resp")"
  SPAWN_CELL=$n
  ( umask 077; { printf 'CELL_NAME=%s\nCELL_NET=%s\nCELL_LIMIT=1000\nCELL_ACCOUNT=%s\nCELL_SERVER_ID=%s\nCELL_IP=\nCELL_STATE=создаётся\nCELL_CREATED=%s\n' \
      "$name" "$net" "$acct" "$sid" "$(date -Iseconds)"; } > "$CELLS_DIR/$n.env"
    printf 'TIMEWEB_TOKEN=%s\nTIMEWEB_SERVER_ID=%s\n' "$tok" "$sid" > "$CELLS_DIR/$n.timeweb.env" )
  sp_log "сервер создан: id=$sid"

  sp_step "ожидание запуска сервера"
  for (( i = 0; i < 90; i++ )); do
    resp=$(twa "$tok" GET "/servers/$sid"); st=$(jq -r '.server.status // empty' <<<"$resp")
    ip=$(jq -r '[.server.networks[]?.ips[]? | select(.type == "ipv4")] | (map(select(.is_main)) + .)[0].ip // empty' <<<"$resp")
    [[ $st == on && -n $ip ]] && break
    # Timeweb создаёт сервер без адреса: когда сервер включился, а IPv4 нет, просим его один раз (так же, как при смене IP)
    if [[ $st == on && -z $ip && -z ${ipreq:-} ]]; then
      sp_log "сервер включился, но адреса нет: запрашиваю IPv4"
      r=$(twa "$tok" POST "/servers/$sid/ips" '{"type":"ipv4"}'); ipreq=1
      jq -e '.server_ip.ip' >/dev/null 2>&1 <<<"$r" || sp_log "Timeweb ответил на запрос IPv4: $(jq -r '.message // empty' <<<"$r" 2>/dev/null | head -c 200)"
    fi
    sleep ${SPAWN_POLL:-10}
  done
  [[ $st == on && -n $ip ]] || sp_fail "сервер не запустился за 15 минут (статус: ${st:-?}, ip: ${ip:-нет})"
  sed -i "s|^CELL_IP=.*|CELL_IP=$ip|" "$CELLS_DIR/$n.env"; sp_log "запущен, IPv4 $ip"
  fi

  # канал homeserv -> Timeweb бывает с потерями пакетов (часть SYN пропадает): повторы соединения и «живой» ssh, каждый шаг с повтором
  ssh=(ssh -T -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=5 -o ServerAliveInterval=10 -o ServerAliveCountMax=12
       -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$CELLS_DIR/$n.known_hosts_public" -i "$ETC_DIR/spawn.key")
  sp_step "ожидание ssh"
  for (( i = 0; i < 120; i++ )); do "${ssh[@]}" "root@$ip" true </dev/null 2>/dev/null && break; sleep 5; done
  (( i < 120 )) || sp_fail "ssh на $ip не отвечает за 10 минут"
  local deb=1
  for (( i = 0; i < 6; i++ )); do
    "${ssh[@]}" "root@$ip" 'grep -q "^ID=debian" /etc/os-release && grep -q "^VERSION_ID=\"1[2-9]\"" /etc/os-release' </dev/null 2>/dev/null; deb=$?
    (( deb == 0 || deb == 1 )) && break; sleep ${SPAWN_RETRY_WAIT:-5}
  done
  (( deb == 0 )) || { (( deb == 1 )) && sp_fail "на сервере не Debian 12+" || sp_fail "не удалось проверить систему сервера (ssh обрывается)"; }
  sp_step "проверка UDP от homeserv до сервера"
  [[ -n ${SPAWN_ADOPT:-} ]] || sp_udp_check "$ip" || sp_fail "UDP от homeserv до $ip не проходит (адрес режется по пути): туннель на нём не поднимется"

  sp_step "подготовка бандла"
  pay=$(mktemp -d); tmp=$pay
  cp "$SELF" "$pay/vampn"; install_sh > "$pay/install.sh"
  cp "${VAMPN_KEYRING:-/usr/share/keyrings/amnezia.gpg}" "$pay/amnezia.gpg" 2>/dev/null || sp_fail "на homeserv нет ключа PPA Amnezia (/usr/share/keyrings/amnezia.gpg)"
  { echo MAIL_METHOD=relay; echo "RELAY_HOST=$net.3"; echo RELAY_PORT=777
    grep -E '^(MAIL_FROM|ALERT_EMAIL)=' "$ETC_DIR/secrets.env" 2>/dev/null; } > "$pay/secrets.env"
  key_root=$(awk '{print $1, $2}' "$ETC_DIR/spawn.key.pub")
  home_pub=$(curl -4 -s -m 8 https://ifconfig.me 2>/dev/null || true); [[ $home_pub =~ ^[0-9.]+$ ]] || home_pub=""
  local -a args=(--net "$net" --span 4 --limit "$(cell_field "$n" CELL_LIMIT)" --name "$name" --public-ip "$ip" --payload /root/vampn-bundle
                 --key-root "$key_root" --key-users "$(awk '{print $1, $2}' "$ETC_DIR/users.key.pub")" --key-mirror "$(awk '{print $1, $2}' "$ETC_DIR/mirror.key.pub")")
  [[ -z $home_pub ]] || args+=(--home-public-ip "$home_pub")
  local ak; ak=$(grep -E ' vampn-admin$' ${HOME_AK:-/root/.ssh/authorized_keys} 2>/dev/null | awk '{print $1, $2}' | head -3)
  while read -r k; do [[ -n $k ]] && args+=(--admin-key "$k vampn-admin"); done <<<"$ak"
  sp_step "установка на $name ($ip): AmneziaWG, nftables, sshd, сторож"
  local q; q=$(printf ' %q' "${args[@]}")
  # install.sh идемпотентен, поэтому при обрыве связи его безопасно запустить заново (до 3 раз)
  for (( i = 1; i <= 3; i++ )); do
    out=$(tar -C "$pay" -cf - . | "${ssh[@]}" "root@$ip" "rm -rf /root/vampn-bundle && mkdir -p /root/vampn-bundle && tar -C /root/vampn-bundle -xf - && bash /root/vampn-bundle/install.sh$q" 2>&1) && break
    sp_log "install.sh, попытка $i из 3 не удалась: $(tail -c 300 <<<"$out" | tr '\n' ' ')"; (( i < 3 )) && sleep ${SPAWN_RETRY_WAIT:-15}
  done
  (( i <= 3 )) || { sp_log "$(tail -c 1500 <<<"$out")"; rm -rf "$pay"; sp_fail "install.sh завершился с ошибкой"; }
  rm -rf "$pay"
  grep -q '^VAMPN_INSTALL_OK=1' <<<"$out" || sp_fail "install.sh не подтвердил установку"
  port=$(sed -n 's/^VAMPN_PORT=//p' <<<"$out"); pubkey=$(sed -n 's/^VAMPN_SERVER_PUBKEY=//p' <<<"$out"); relay_pub=$(sed -n 's/^VAMPN_MAILRELAY_PUB=//p' <<<"$out")
  [[ $port =~ ^[0-9]+$ && -n $pubkey && -n $relay_pub ]] || sp_fail "install.sh не вернул порт и ключи"
  sp_log "установлено: порт $port"

  sp_step "ключ почты сервера на homeserv и конфиг туннеля"
  relay_authorize "$n" "$net" "$relay_pub" || sp_fail "сервер вернул непонятный ключ почты"
  ( umask 077; "${ssh[@]}" "root@$ip" "/usr/local/sbin/vampn homeconf" </dev/null \
      | awk -v srv="$net.1" -v ep="$ip:$port" '/^DNS *=/{next} /^AllowedIPs *=/{print "AllowedIPs = " srv "/32"; next} /^Endpoint *=/{print "Endpoint = " ep; next} {print}' \
      > "$AWG_DIR/vampn$n.conf" )
  grep -q '^PrivateKey' "$AWG_DIR/vampn$n.conf" && grep -q "^Endpoint = $ip:$port" "$AWG_DIR/vampn$n.conf" || sp_fail "не удалось получить конфиг туннеля с сервера"

  sp_step "туннель homeserv - $name"
  systemctl enable --now "awg-quick@vampn$n" >/dev/null 2>&1 || sp_fail "туннель vampn$n не поднялся"
  for (( i = 0; i < 36; i++ )); do
    st=$(awg show "vampn$n" latest-handshakes 2>/dev/null | awk '{print $2; exit}'); [[ $st =~ ^[0-9]+$ && $st -gt 0 ]] && break
    # у wireguard 18 попыток рукопожатия, потом он молчит до следующего трафика, а NAT иногда глотит пакеты с одного исходного порта:
    # перезапуск интерфейса даёт новый порт и новую серию попыток
    (( i == 8 || i == 16 || i == 24 )) && { sp_log "рукопожатия нет, перезапускаю туннель vampn$n (новый исходный порт)"; systemctl restart "awg-quick@vampn$n" >/dev/null 2>&1 || true; }
    sleep 5
  done
  [[ $st =~ ^[0-9]+$ && $st -gt 0 ]] || sp_fail "рукопожатия с новым сервером нет за 3 минуты (туннель перезапускался трижды)"
  local scan pubscan
  scan=$(ssh-keyscan -T 8 -t ed25519 "$net.1" 2>/dev/null | grep -v '^#' | awk '{print $2, $3}')
  pubscan=$(awk '$1 !~ /^#/ {print $2, $3}' "$CELLS_DIR/$n.known_hosts_public" | head -1)
  [[ -n $scan ]] || sp_fail "sshd нового сервера не отвечает через туннель"
  [[ -z $pubscan || $scan == "$pubscan" ]] || sp_fail "ключ sshd через туннель не совпал с ключом при создании (подмена?)"
  echo "$net.1 $scan" > "$CELLS_DIR/$n.known_hosts"; chmod 600 "$CELLS_DIR/$n.known_hosts"

  sp_step "сторож ячейки"
  cell_units
  sed -i 's/^CELL_STATE=.*/CELL_STATE=активна/' "$CELLS_DIR/$n.env"
  systemctl enable --now "vampn-cell@$n.timer" >/dev/null 2>&1 || sp_fail "таймер сторожа ячейки не включился"
  VAMPN_CELL=$n "$SELF" users >/dev/null 2>&1 || true
  VAMPN_CELL=$n "$SELF" mirror >/dev/null 2>&1 || true
  echo "done: ячейка $n ($name) $ip" > "$SPAWN_DIR/job.state"
  sp_log "ГОТОВО: ячейка $n, сервер $name, IPv4 $ip. Новые пользователи назначаются в ячейку с местом."
  sp_notify "развёрнута ячейка $n: сервер $name, $ip (Amsterdam, Debian). Пользователей в неё назначает третий столбец users.conf ($n)."
  if [[ -n ${SPAWN_ADOPT:-} && ${SPAWN_RESCUE_HOURS:-0} -gt 0 ]]; then
    sp_step "перенос отвалившихся пользователей в ячейку $n"
    local l rc
    ( rescue_main "$n" --hours "$SPAWN_RESCUE_HOURS" ) 2>&1 | while read -r l; do sp_log "$l"; done
    sp_log "перенос закончен (подробности выше); ход рассылки: vampn mailstatus"
    echo "done: ячейка $n ($name) $ip" > "$SPAWN_DIR/job.state"
  fi
}

rescue_main() { # N [--hours Ч] [--dry] - всех «отвалившихся» из ВСЕХ ячеек перенести в ячейку N: им уходят новые ключи
  # отвалившийся: в его ячейке нет рукопожатия дольше Ч часов (по умолчанию 1), либо он ни разу не подключался, либо ячейка совсем не отвечает
  (( CELL == 1 )) || die "rescue запускается без VAMPN_CELL"
  local n=${1:-} hours=1 dry=0 c out name email cc hs reason age lim cur cnt=0 moved="" cells_touched=" "
  shift || true
  while (( $# )); do
    case $1 in --hours) hours=${2:-}; shift 2 ;; --dry) dry=1; shift ;; *) die "vampn rescue N [--hours Ч] [--dry]" ;; esac
  done
  [[ $n =~ ^[0-9]+$ ]] || die "vampn rescue N [--hours Ч] [--dry]  (N - ячейка, в которую переносим)"
  [[ $hours =~ ^[0-9]+$ ]] && (( hours >= 1 )) || die "--hours: целое число часов"
  [[ " $(cell_ids | tr '\n' ' ') " == *" $n "* ]] || die "нет ячейки $n"
  local USERS=${VAMPN_USERS:-/etc/vampn/users.conf} t0; t0=$(now)
  [[ -f $USERS ]] || die "нет $USERS"
  declare -A hsmax down
  for c in $(cell_ids); do
    [[ $c == "$n" ]] && continue
    (( $(cell_users "$c") > 0 )) || continue
    if out=$(VAMPN_CELL=$c "$SELF" peers 2>/dev/null </dev/null) && [[ -n $out ]]; then
      while IFS=$'\t' read -r _ _ name _ hs _ _; do [[ -n $name ]] && hsmax[$c:$name]=${hs:-0}; done <<<"$out"
    else down[$c]=1; fi
  done
  printf '%-20s %-8s %s\n' ПОЛЬЗОВАТЕЛЬ ЯЧЕЙКА ПРИЧИНА
  while read -r name email cc; do
    [[ -z $name || $name == \#* ]] && continue
    [[ $cc =~ ^[0-9]+$ ]] || cc=1
    [[ $cc == "$n" ]] && continue
    if [[ -n ${down[$cc]:-} ]]; then reason="ячейка $cc не отвечает"
    else
      hs=${hsmax[$cc:$name]:-0}
      if (( hs == 0 )); then reason="ни разу не подключался"
      else age=$(( t0 - hs )); (( age > hours * 3600 )) && reason="последнее подключение $(( age / 3600 )) ч назад" || continue
      fi
    fi
    printf '%-20s %-8s %s\n' "$name" "$cc" "$reason"
    moved+=" $name"; cnt=$(( cnt + 1 )); [[ $cells_touched == *" $cc "* ]] || cells_touched+="$cc "
  done < <(sed 's/\r$//' "$USERS")
  echo "отвалившихся: $cnt (порог $hours ч)"
  (( cnt > 0 )) || return 0
  lim=$(cell_field "$n" CELL_LIMIT); cur=$(cell_users "$n")
  if (( cur + cnt > ${lim:-1000} )); then
    (( dry )) && echo "ВНИМАНИЕ: в ячейке $n не хватит места: уже $cur, переносим $cnt, лимит ${lim:-1000}" || die "в ячейке $n не хватит места: уже $cur, переносим $cnt, лимит ${lim:-1000}"
  fi
  (( dry )) && { echo "это пробный запуск (--dry): ничего не изменено"; return 0; }
  cp -p "$USERS" "$USERS.bak.$(date +%Y%m%d%H%M%S)"
  local tmp; tmp=$(mktemp)
  sed 's/\r$//' "$USERS" | awk -v moved="$moved " -v c="$n" '
    /^[[:space:]]*#/ || NF == 0 { print; next }
    index(moved, " " $1 " ") { print $1, $2, c; next }
    { print }' > "$tmp"
  cat "$tmp" > "$USERS"; rm -f "$tmp"
  echo "users.conf обновлён (копия рядом, .bak.*): $cnt пользователей теперь в ячейке $n"
  for c in $cells_touched $n; do
    out=$(VAMPN_CELL=$c "$SELF" users 2>&1 </dev/null) && echo "ячейка $c: список применён" || echo "ячейка $c: применить сейчас не вышло ($(tail -c 150 <<<"$out" | tr '\n' ' ')), применится сама, когда сервер ответит"
  done
  echo "новые ключи уходят на почту; кому не дошло - vampn mailstatus, повторить - vampn resendall"
}

adopt_main() { # IP [--hours Ч] [--no-rescue] - сервер, поднятый командой vampn init, становится ячейкой; отвалившиеся из всех ячеек переезжают в неё
  (( CELL == 1 )) || die "adopt запускается без VAMPN_CELL"
  local ip=${1:-} hours=1 key out
  shift || true
  while (( $# )); do
    case $1 in --hours) hours=${2:-}; shift 2 ;; --no-rescue) hours=0; shift ;; *) die "vampn adopt IP [--hours Ч] [--no-rescue]" ;; esac
  done
  [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "vampn adopt IP [--hours Ч] [--no-rescue]"
  [[ $hours =~ ^[0-9]+$ ]] || die "--hours: целое число часов"
  [[ -f $ETC_DIR/spawn.key.pub ]] || die "нет $ETC_DIR/spawn.key.pub (ключ создаётся первой арендой vampn spawn)"
  key=$(awk '{print $1, $2}' "$ETC_DIR/spawn.key.pub")
  install -d -m 700 "$SPAWN_DIR"
  if ! ssh -T -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=3 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile=/dev/null -i "$ETC_DIR/spawn.key" "root@$ip" true </dev/null 2>/dev/null; then
    echo "не могу войти на $ip по ключу homeserv. Выполните на том сервере одну строку и повторите vampn adopt $ip:" >&2
    echo "  echo '$key homeserv' >> /root/.ssh/authorized_keys" >&2
    exit 1
  fi
  if ! ( exec 7>"$SPAWN_DIR/lock"; flock -n 7 ); then die "уже идёт аренда или усыновление (vampn spawnstatus)"; fi
  echo "queued: усыновление $ip" > "$SPAWN_DIR/job.state"; : > "$SPAWN_DIR/job.log"
  if command -v systemd-run >/dev/null 2>&1 && [[ -z ${VAMPN_NO_SYSTEMD:-} ]]; then
    systemd-run -q --collect --unit "vampn-adopt-$(date +%s)" -E "SPAWN_ADOPT=$ip" -E "SPAWN_RESCUE_HOURS=$hours" -E SPAWN_KEEPLOG=1 "$SELF" spawnrun main >/dev/null
  else SPAWN_ADOPT=$ip SPAWN_RESCUE_HOURS=$hours SPAWN_KEEPLOG=1 nohup setsid "$SELF" spawnrun main >/dev/null 2>&1 </dev/null & fi
  echo "усыновление запущено в фоне. Ход: vampn spawnstatus 40"
}

cell_units() { # шаблон сторожа ячейки: vampn-cell@N.service/.timer (то же самое, что vampn.timer для ячейки 1)
  cat > "${VAMPN_UNITS:-/etc/systemd/system}/vampn-cell@.service" <<'UNIT'
[Unit]
Description=vampn: watch VPN cell %i
After=network-online.target awg-quick@vampn%i.service
[Service]
Type=oneshot
Environment=VAMPN_CELL=%i
ExecStart=/usr/local/sbin/vampn check
UNIT
  cat > "${VAMPN_UNITS:-/etc/systemd/system}/vampn-cell@.timer" <<'UNIT'
[Unit]
Description=vampn: check VPN cell %i every minute
[Timer]
OnBootSec=2min
OnUnitActiveSec=60
AccuracySec=10
[Install]
WantedBy=timers.target
UNIT
  systemctl daemon-reload
}

spawn_main() { # [КАБИНЕТ] - запускает аренду в фоне и сразу возвращается
  local acct=${1:-}
  (( CELL == 1 )) || die "spawn запускается без VAMPN_CELL"
  [[ -n $acct ]] || acct=$(acct_default)
  [[ -f $(acct_file "$acct") ]] || die "нет кабинета $acct (vampn account add $acct)"
  install -d -m 700 "$SPAWN_DIR"
  if ! ( exec 7>"$SPAWN_DIR/lock"; flock -n 7 ); then die "аренда уже идёт (vampn spawnstatus)"; fi
  echo "queued: старт" > "$SPAWN_DIR/job.state"
  if command -v systemd-run >/dev/null 2>&1 && [[ -z ${VAMPN_NO_SYSTEMD:-} ]]; then
    systemd-run -q --collect --unit "vampn-spawn-$(date +%s)" "$SELF" spawnrun "$acct" >/dev/null
  else nohup setsid "$SELF" spawnrun "$acct" >/dev/null 2>&1 </dev/null & fi
  echo "аренда запущена в фоне (кабинет $acct). Ход: vampn spawnstatus"
}

spawn_discard() { # N - нерабочий сервер ячейки N: убрать ключ почты с homeserv, удалить сервер в Timeweb и саму ячейку
  local c=$1 l
  sp_log "удаляю нерабочий сервер ячейки $c и саму ячейку"
  sed -i "/ vampn-mailrelay-$c\$/d" "${HOME_AK:-/root/.ssh/authorized_keys}" 2>/dev/null || true
  ( cell_del "$c" --yes --force ) 2>&1 | while read -r l; do sp_log "$l"; done
}

spawn_loop() { # КАБИНЕТ - до SPAWN_TRIES (5) попыток: упало после создания сервера - сервер и ячейка удаляются, берём новый сервер
  local acct=$1 tries=${SPAWN_TRIES:-5} try cell
  install -d -m 700 "$SPAWN_DIR" "$CELLS_DIR"
  for (( try = 1; try <= tries; try++ )); do
    rm -f "$SPAWN_DIR/last_cell"
    (( try > 1 )) && { SPAWN_KEEPLOG=1; sp_log "=== попытка $try из $tries: новый сервер ==="; }
    ( SPAWN_AUTO=1 spawn_run "$acct" )
    [[ $(cut -d: -f1 "$SPAWN_DIR/job.state" 2>/dev/null) == done ]] && return 0
    cell=$(cat "$SPAWN_DIR/last_cell" 2>/dev/null || true)
    [[ -n $cell ]] || return 1        # упало до создания сервера (токен, баланс, тарифы) - новый сервер не поможет
    spawn_discard "$cell"
    (( try < tries )) || { sp_notify "после $tries попыток новый сервер развернуть не удалось, лишние серверы удалены. Причина в журнале: vampn spawnstatus"; return 1; }
  done
}

spawn_resume_main() { # N - продолжить развёртывание на уже созданном сервере ячейки N (spawn упал, сервер и ячейка остались)
  local n=${1:-} acct
  (( CELL == 1 )) || die "spawnresume запускается без VAMPN_CELL"
  [[ $n =~ ^[0-9]+$ ]] && (( n >= 2 )) || die "нужен номер ячейки: vampn spawnresume N"
  [[ -f $CELLS_DIR/$n.env && -f $CELLS_DIR/$n.timeweb.env ]] || die "нет ячейки $n"
  acct=$(sed -n 's/^CELL_ACCOUNT=//p' "$CELLS_DIR/$n.env")
  install -d -m 700 "$SPAWN_DIR"
  if ! ( exec 7>"$SPAWN_DIR/lock"; flock -n 7 ); then die "аренда уже идёт (vampn spawnstatus)"; fi
  echo "queued: продолжение ячейки $n" > "$SPAWN_DIR/job.state"
  if command -v systemd-run >/dev/null 2>&1 && [[ -z ${VAMPN_NO_SYSTEMD:-} ]]; then
    systemd-run -q --collect --unit "vampn-spawn-$(date +%s)" -E "SPAWN_RESUME=$n" "$SELF" spawnrun "${acct:-main}" >/dev/null
  else SPAWN_RESUME=$n nohup setsid "$SELF" spawnrun "${acct:-main}" >/dev/null 2>&1 </dev/null & fi
  echo "продолжаю развёртывание ячейки $n в фоне. Ход: vampn spawnstatus"
}

spawn_status() {
  local n=${1:-25}; [[ $n =~ ^[0-9]+$ ]] || n=25
  echo "состояние: $(cat "$SPAWN_DIR/job.state" 2>/dev/null || echo нет запусков)"
  tail -n "$n" "$SPAWN_DIR/job.log" 2>/dev/null
}

cell_del() { # N --yes [--force]
  local n=${1:-} yes=0 force=0 a tok sid acct us
  shift || true
  for a in "$@"; do case $a in --yes) yes=1 ;; --force) force=1 ;; *) die "лишний параметр $a" ;; esac; done
  [[ $n =~ ^[0-9]+$ ]] && (( n >= 2 )) || die "vampn celldel N --yes [--force]  (N от 2: ячейку 1 удалить нельзя)"
  [[ -f $CELLS_DIR/$n.env ]] || die "нет ячейки $n"
  (( yes )) || die "это удалит сервер в Timeweb и ячейку $n. Повторите с --yes"
  us=$(cell_users "$n"); (( us == 0 || force )) || die "в ячейке $n $us пользователей: сначала перенесите их (или --force)"
  sid=$(cell_field "$n" CELL_SERVER_ID); acct=$(cell_field "$n" CELL_ACCOUNT); tok=$(acct_token "$acct")
  systemctl disable --now "vampn-cell@$n.timer" "awg-quick@vampn$n" >/dev/null 2>&1 || true
  if [[ -n $tok && -n $sid ]]; then
    local r; r=$(twa "$tok" DELETE "/servers/$sid")
    echo "Timeweb: $(jq -r '.message // .error_code // "запрос принят"' <<<"$r" 2>/dev/null)"
  fi
  rm -f "$CELLS_DIR/$n.env" "$CELLS_DIR/$n.timeweb.env" "$CELLS_DIR/$n.known_hosts" "$CELLS_DIR/$n.known_hosts_public" "$AWG_DIR/vampn$n.conf"
  rm -rf "/var/lib/vampn/cells/$n"
  echo "ячейка $n убрана из системы. Сервер $sid в Timeweb: если токен без права удаления без подтверждения, удалите его в панели вручную"
}

# >>> install.sh (встроено командой embed.sh, не править здесь)
install_sh() { cat <<'INSTALL_EOF'
#!/bin/bash
# install.sh - разворачивает VPN-сервер vampn на ЧИСТОМ Debian 13 (root) за несколько минут.
# Его запускает `vampn spawn` на homeserv (после аренды сервера в Timeweb); вручную тоже можно.
# Что ставит: AmneziaWG (модуль DKMS из PPA Amnezia + утилиты из исходников, версия закреплена), nftables, sysctl, sshd только по ключам,
# скрипт vampn + таймер самопроверки, ключи и параметры маскировки САМОГО сервера (у каждой ячейки свои), ключи homeserv с ограничениями.
# Идемпотентен: повторный запуск ничего не ломает, существующие ключи и конфиги сервера не перезаписываются.
#
#   install.sh --net 10.77.4 --payload DIR --key-root 'ssh-ed25519 ...' --key-users '...' --key-mirror '...'
#              [--public-ip IP] [--span 4] [--limit 1000] [--port N] [--home-public-ip IP] [--admin-key '...']... [--no-game] [--name vampn_2]
#              [--standalone]                    сервер без homeserv (так работает `vampn init`): ключи homeserv не нужны, ssh открыт всем (по ключам, если они есть)
#              [--packages-only]                 только поставить пакеты, модуль AmneziaWG и утилиты awg (так работает `vampn init`)
#              [--render-only --root DIR]        только записать файлы в DIR (для проверки), ничего не ставить и не запускать
#   В DIR (--payload): vampn (скрипт), amnezia.gpg (ключ PPA), secrets.env (почта через homeserv: MAIL_METHOD=relay ...), необязательно.
# В конце печатает строки "VAMPN_*=..." (порт, публичный ключ сервера, ключ для почты) - их читает spawn.
set -euo pipefail

TOOLS_TAG=v3.1.20260812 TOOLS_COMMIT=ee0f0a9aa34ff0a0da4b3433b9512781cfe02843   # amnezia-vpn/amneziawg-tools, как на рабочих серверах
NET="" SPAN=4 LIMIT=1000 PORT="" PUBLIC_IP="" HOME_PUB_IP="" PAYLOAD="" NAME="" GAME=1 RENDER_ONLY=0 ROOT="" PACKAGES_ONLY=0 STANDALONE=0
KEY_ROOT="" KEY_USERS="" KEY_MIRROR="" ADMIN_KEYS=()
say() { echo "[install] $*" >&2; }
die() { echo "install.sh: $*" >&2; exit 1; }

while (( $# )); do
  case $1 in
    --net) NET=$2; shift 2 ;;            --span) SPAN=$2; shift 2 ;;      --limit) LIMIT=$2; shift 2 ;;
    --port) PORT=$2; shift 2 ;;          --payload) PAYLOAD=$2; shift 2 ;; --name) NAME=$2; shift 2 ;;
    --home-public-ip) HOME_PUB_IP=$2; shift 2 ;;  --public-ip) PUBLIC_IP=$2; shift 2 ;;
    --key-root) KEY_ROOT=$2; shift 2 ;;  --key-users) KEY_USERS=$2; shift 2 ;; --key-mirror) KEY_MIRROR=$2; shift 2 ;;
    --admin-key) ADMIN_KEYS+=("$2"); shift 2 ;;
    --no-game) GAME=0; shift ;;
    --packages-only) PACKAGES_ONLY=1; shift ;;
    --standalone) STANDALONE=1; GAME=0; shift ;;
    --render-only) RENDER_ONLY=1; shift ;; --root) ROOT=${2%/}; shift 2 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) die "неизвестный параметр $1" ;;
  esac
done

# ---------- проверка входных данных ----------
if (( PACKAGES_ONLY )); then [[ $EUID == 0 ]] || die "нужен root"; ROOT=""; else
[[ $NET =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || die "--net: три октета, например 10.77.4"
[[ $SPAN =~ ^[1-4]$ ]] || die "--span: от 1 до 4 подряд идущих /24"
[[ $LIMIT =~ ^[0-9]+$ ]] || die "--limit: число"
[[ -z $PORT || $PORT =~ ^[0-9]{4,5}$ ]] || die "--port: число"
[[ -z $PUBLIC_IP || $PUBLIC_IP =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "--public-ip: адрес IPv4"
[[ -z $HOME_PUB_IP || $HOME_PUB_IP =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "--home-public-ip: адрес IPv4"
okkey() { [[ $1 =~ ^ssh-(ed25519|rsa)\ [A-Za-z0-9+/=]+(\ [^\"\']*)?$ ]]; }
for k in "$KEY_ROOT" "$KEY_USERS" "$KEY_MIRROR" "${ADMIN_KEYS[@]}"; do [[ -z $k ]] || okkey "$k" || die "не похоже на открытый ключ ssh: ${k:0:30}"; done
(( STANDALONE )) || [[ -n $KEY_ROOT && -n $KEY_USERS && -n $KEY_MIRROR ]] || die "нужны --key-root, --key-users и --key-mirror (открытые ключи homeserv)"
[[ -n $PAYLOAD && -f $PAYLOAD/vampn ]] || die "--payload DIR: в каталоге должен лежать скрипт vampn"
if (( ! RENDER_ONLY )); then [[ $EUID == 0 ]] || die "нужен root"; ROOT=""; else [[ -n $ROOT ]] || die "--render-only требует --root DIR"; fi

HOME_TIP=$NET.3 SRV_TIP=$NET.1
case $SPAN in 1) CIDR=24 ;; 2) CIDR=23 ;; *) CIDR=22; SPAN=4 ;; esac   # три /24 подряд в одну маску не уложить - берём /22 (третий октет сети кратен числу /24)
(( ${NET##*.} % SPAN == 0 )) || die "--net: третий октет ${NET##*.} не кратен $SPAN (сеть /$CIDR должна начинаться на границе)"
D=$ROOT/etc/amnezia/amneziawg V=$ROOT/root/vampn
fi

# ---------- что записать: функции без побочных эффектов, кроме файлов ----------
rnd() { shuf -i "$1-$2" -n 1; }

gen_params() {  # параметры маскировки AmneziaWG 2.0 (как setup_awg.sh на основном сервере); ключи сервера - только если конфига ещё нет
  [[ -n $PORT ]] || PORT=$(rnd 30000 60999)
  JC=$(rnd 4 8); JMIN=$(rnd 40 80); JMAX=$(rnd 600 1000)
  while :; do S1=$(rnd 15 150); S2=$(rnd 15 150); (( S1 + 56 != S2 )) && break; done
  S3=$(rnd 15 64); S4=$(rnd 4 24)
  local b; b=$(rnd 100000000 400000000)
  H1="$b-$((b + 50000000))"; H2="$((b + 60000000))-$((b + 110000000))"; H3="$((b + 120000000))-$((b + 170000000))"; H4="$((b + 180000000))-$((b + 230000000))"
  I1="<b 0xc30000000108><r 8><b 0x0000449e><r 1150>"   # имитация QUIC v1 Initial
}

write_awg() {
  install -d -m 700 "$D" "$V" "$V/clients"
  [[ -n $PUBLIC_IP ]] && ! [[ -f $V/endpoint ]] && echo "$PUBLIC_IP" > "$V/endpoint"
  if [[ -f $D/awg0.conf ]]; then say "awg0.conf уже есть - ключи и параметры сервера не трогаю"; return 0; fi
  [[ -f $V/endpoint ]] || { PUBLIC_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p'); [[ -n $PUBLIC_IP ]] && echo "$PUBLIC_IP" > "$V/endpoint"; }
  gen_params
  local sk pk; sk=$(awg genkey); pk=$(echo "$sk" | awg pubkey)
  ( umask 077
    cat > "$D/awg0.conf" <<EOF
[Interface]
Address = $SRV_TIP/$CIDR
ListenPort = $PORT
PrivateKey = $sk
Jc = $JC
Jmin = $JMIN
Jmax = $JMAX
S1 = $S1
S2 = $S2
S3 = $S3
S4 = $S4
H1 = $H1
H2 = $H2
H3 = $H3
H4 = $H4
EOF
    cat > "$V/server.env" <<EOF
SERVER_PUBKEY=$pk
PORT=$PORT
JC=$JC
JMIN=$JMIN
JMAX=$JMAX
S1=$S1
S2=$S2
S3=$S3
S4=$S4
H1=$H1
H2=$H2
H3=$H3
H4=$H4
I1='$I1'
MTU=$((1420 - S4 - 20))
SUBNET=$NET
SUBNET_SPAN=$SPAN
SUBNET_CIDR=$CIDR
CLIENT_LIMIT=$LIMIT
EOF
  )
}

write_sysctl() {
  install -d "$ROOT/etc/sysctl.d"
  cat > "$ROOT/etc/sysctl.d/90-vampn.conf" <<'EOF'
net.ipv4.ip_forward = 1
net.ipv4.icmp_echo_ignore_all = 1
net.ipv6.icmp.echo_ignore_all = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.mptcp.enabled = 0
EOF
}

write_nft() {
  local port; port=$(awk -F' *= *' '/^ListenPort/{print $2; exit}' "$D/awg0.conf")
  local ssh_pub="" game_fwd="" game_nat="" ssh_in="iifname \$VPN ip saddr $HOME_TIP tcp dport 22 accept"
  (( ! STANDALONE )) || ssh_in="iifname \$WAN tcp dport 22 accept"
  [[ -z $HOME_PUB_IP ]] || ssh_pub="        # homeserv по публичному адресу (если туннель лёг): только ssh и только с него
        ip saddr $HOME_PUB_IP tcp dport 22 accept"
  if (( GAME )); then
    game_fwd="        # Minecraft и голосовой чат на homeserv ($HOME_TIP) - только для клиентов VPN
        iifname \$VPN oifname \$VPN ip daddr $HOME_TIP tcp dport 25565 accept
        iifname \$VPN oifname \$VPN ip daddr $HOME_TIP udp dport 24454 accept"
    game_nat="        ip saddr $NET.0/$CIDR ip daddr $HOME_TIP tcp dport 25565 oifname \$VPN masquerade
        ip saddr $NET.0/$CIDR ip daddr $HOME_TIP udp dport 24454 oifname \$VPN masquerade"
  fi
  install -d "$ROOT/etc"
  cat > "$ROOT/etc/nftables.conf" <<EOF
#!/usr/sbin/nft -f
# vampn firewall (install.sh): наружу открыт порт AmneziaWG; ssh - из туннеля с адреса homeserv (в режиме standalone - отовсюду).
flush ruleset

define WAN = "eth0"
define VPN = "awg0"
define AWG_PORT = $port

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;
        iif lo accept
        ct state invalid drop
        ct state established,related accept
        meta l4proto ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, packet-too-big } accept
        iifname \$WAN udp dport \$AWG_PORT accept
        $ssh_in
${ssh_pub}
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        tcp flags syn tcp option maxseg size set rt mtu
        ct state invalid drop
        ct state established,related accept
        iifname \$VPN oifname \$WAN accept
${game_fwd}
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100;
        ip saddr $NET.0/$CIDR oifname \$WAN masquerade
${game_nat}
    }
}
EOF
  chmod 755 "$ROOT/etc/nftables.conf"
}

write_ssh() {
  install -d -m 700 "$ROOT/root/.ssh"; install -d "$ROOT/etc/ssh/sshd_config.d"
  local ak=$ROOT/root/.ssh/authorized_keys
  if (( STANDALONE )); then
    # без homeserv: вход по паролю отключаем только если у root уже есть ключ, иначе хозяин останется за дверью
    if grep -E '^(ssh-|ecdsa-|sk-)' "$ak" 2>/dev/null | grep -qvE ' homeserv$'; then
      printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin prohibit-password\n' > "$ROOT/etc/ssh/sshd_config.d/00-vampn.conf"
    else
      say "ВНИМАНИЕ: у root нет ssh-ключа - вход по паролю оставлен. Добавьте ключ в /root/.ssh/authorized_keys, тогда пароль можно отключить"
    fi
    return 0
  fi
  cat > "$ROOT/etc/ssh/sshd_config.d/00-vampn.conf" <<'EOF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
EOF
  local tmp k; tmp=$(mktemp)
  [[ -f $ak ]] && grep -vE ' (homeserv|homeserv-mirror|homeserv-users|vampn-admin)$' "$ak" > "$tmp" || true
  for k in "${ADMIN_KEYS[@]}"; do echo "$k"; done | awk 'NF' | sed -E 's/^(ssh-[a-z0-9-]+ [A-Za-z0-9+\/=]+).*/\1 vampn-admin/' >> "$tmp"
  echo "restrict,from=\"$HOME_TIP\",command=\"tar -C /root/vampn -czf - server.env endpoint clients\" $(awk '{print $1, $2}' <<<"$KEY_MIRROR") homeserv-mirror" >> "$tmp"
  echo "restrict,from=\"$HOME_TIP\",command=\"/usr/local/sbin/vampn remote\" $(awk '{print $1, $2}' <<<"$KEY_USERS") homeserv-users" >> "$tmp"
  echo "$(awk '{print $1, $2}' <<<"$KEY_ROOT") homeserv" >> "$tmp"
  install -m 600 "$tmp" "$ak"; rm -f "$tmp"
}

write_units() {
  install -d "$ROOT/etc/systemd/system" "$ROOT/usr/local/sbin"
  install -m 755 "$PAYLOAD/vampn" "$ROOT/usr/local/sbin/vampn"
  cat > "$ROOT/etc/systemd/system/vampn.service" <<'EOF'
[Unit]
Description=vampn: self-check (firewall, awg0, network, public IP change)
Wants=network-online.target
After=network-online.target awg-quick@awg0.service nftables.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vampn check
EOF
  cat > "$ROOT/etc/systemd/system/vampn.timer" <<'EOF'
[Unit]
Description=vampn: self-check every minute
[Timer]
OnBootSec=30
OnUnitActiveSec=60
AccuracySec=10
[Install]
WantedBy=timers.target
EOF
  install -d -m 700 "$ROOT/etc/vampn"
  if [[ -f $PAYLOAD/secrets.env ]]; then install -m 600 "$PAYLOAD/secrets.env" "$ROOT/etc/vampn/secrets.env"
  elif (( STANDALONE )); then printf 'MAIL_METHOD=smtp\n' > "$ROOT/etc/vampn/secrets.env"; chmod 600 "$ROOT/etc/vampn/secrets.env"
  else printf 'MAIL_METHOD=relay\nRELAY_HOST=%s\nRELAY_PORT=777\n' "$HOME_TIP" > "$ROOT/etc/vampn/secrets.env"; chmod 600 "$ROOT/etc/vampn/secrets.env"; fi
  grep -q '^RELAY_HOST=' "$ROOT/etc/vampn/secrets.env" || printf 'RELAY_HOST=%s\n' "$HOME_TIP" >> "$ROOT/etc/vampn/secrets.env"
}

# ---------- то, что делается только на живом сервере ----------
PKGS=(curl jq nftables python3 ca-certificates gnupg git make gcc build-essential dkms perl "linux-headers-$(uname -r)" openssh-server unattended-upgrades systemd-timesyncd traceroute qrencode)
install_packages() {
  export DEBIAN_FRONTEND=noninteractive
  # повторный запуск (усыновление сервера, поднятого vampn init): всё уже стоит и модуль грузится - сеть к apt не трогаем
  if dpkg -s "${PKGS[@]}" amneziawg-dkms >/dev/null 2>&1 && { modprobe amneziawg 2>/dev/null || false; }; then say "пакеты уже стоят"; return 0; fi
  say "пакеты"
  # у новых серверов Timeweb сеть бывает с потерями: apt сам повторяет загрузки
  local -a APT=(apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30)
  "${APT[@]}" update -qq
  "${APT[@]}" install -y -qq "${PKGS[@]}" >/dev/null
  if [[ -f $PAYLOAD/amnezia.gpg ]]; then install -m 644 "$PAYLOAD/amnezia.gpg" /usr/share/keyrings/amnezia.gpg
  elif [[ ! -s /usr/share/keyrings/amnezia.gpg ]]; then
    # на чистом сервере ключа ещё нет (его кладёт spawn): пробуем взять с сервера ключей Ubuntu
    local g; g=$(mktemp -d); chmod 700 "$g"
    GNUPGHOME=$g gpg -q --batch --keyserver hkps://keyserver.ubuntu.com --recv-keys 75C9DD72C799870E310542E24166F2C257290828 >/dev/null 2>&1 \
      && GNUPGHOME=$g gpg -q --batch --export 75C9DD72C799870E310542E24166F2C257290828 > /usr/share/keyrings/amnezia.gpg 2>/dev/null || true
    rm -rf "$g"
    [[ -s /usr/share/keyrings/amnezia.gpg ]] || die "нет ключа PPA Amnezia: положите amnezia.gpg в /usr/share/keyrings или в --payload"
  fi
  echo 'deb [signed-by=/usr/share/keyrings/amnezia.gpg] https://ppa.launchpadcontent.net/amnezia/ppa/ubuntu noble main' > /etc/apt/sources.list.d/amnezia.list
  "${APT[@]}" update -qq
  "${APT[@]}" install -y -qq amneziawg-dkms >/dev/null
  modprobe amneziawg 2>/dev/null || dkms autoinstall >/dev/null 2>&1 || true
  modprobe amneziawg || die "модуль amneziawg не загрузился (dkms status: $(dkms status 2>&1 | head -2 | tr '\n' ' '))"
}

install_tools() {
  if command -v awg >/dev/null && awg --version 2>&1 | grep -q "${TOOLS_TAG#v}"; then say "утилиты awg уже стоят"; return 0; fi
  say "утилиты awg ($TOOLS_TAG)"
  local src=/usr/local/src/amneziawg-tools
  if [[ ! -d $src/.git ]]; then
    local t; for t in 1 2 3 4 5; do rm -rf "$src"; git clone -q https://github.com/amnezia-vpn/amneziawg-tools "$src" && break; sleep 5; done
    [[ -d $src/.git ]] || die "не удалось скачать amneziawg-tools с GitHub"
  fi
  git -C "$src" fetch -q --tags origin 2>/dev/null || true
  git -C "$src" checkout -q "$TOOLS_COMMIT"
  make -C "$src/src" -j2 >/dev/null
  make -C "$src/src" install PREFIX=/usr WITH_SYSTEMDUNITS=yes WITH_WGQUICK=yes >/dev/null
  command -v awg >/dev/null || die "awg не установился"
}

activate() {
  say "запуск"
  systemctl daemon-reload
  sysctl -q --system
  systemctl enable --now nftables >/dev/null 2>&1; nft -f /etc/nftables.conf
  sshd -t && systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
  systemctl enable --now awg-quick@awg0 >/dev/null
  systemctl enable --now vampn.timer >/dev/null
  if [[ -n $NAME ]]; then hostnamectl set-hostname "$NAME" 2>/dev/null || hostnamectl set-hostname "${NAME//_/-}" 2>/dev/null || true; fi
  [[ -f /root/.ssh/mailrelay ]] || ssh-keygen -q -t ed25519 -N '' -C "vampn-mailrelay" -f /root/.ssh/mailrelay
  # настройки автообновлений безопасности остаются по умолчанию Debian
}

verify() {
  ip link show awg0 >/dev/null 2>&1 || die "интерфейс awg0 не поднялся"
  ss -lunH "sport = :$(awk -F' *= *' '/^ListenPort/{print $2; exit}' "$D/awg0.conf")" | grep -q . || die "порт VPN не слушается"
  nft list table inet filter >/dev/null 2>&1 || die "nftables не загружен"
  [[ $(sysctl -n net.ipv4.ip_forward) == 1 ]] || die "ip_forward выключен"
  /usr/local/sbin/vampn status >/dev/null 2>&1 || die "vampn status не отработал"
}

# ---------- ход ----------
if (( RENDER_ONLY )); then
  [[ -z ${FAKE_BIN:-} ]] || PATH=$FAKE_BIN:$PATH
  write_awg; write_sysctl; write_nft; write_ssh; write_units
  say "записано в $ROOT (render-only)"
  exit 0
fi
install_packages
install_tools
if (( PACKAGES_ONLY )); then say "пакеты и утилиты awg готовы"; echo "VAMPN_INIT_OK=1"; exit 0; fi
write_awg; write_sysctl; write_nft; write_ssh; write_units
if (( STANDALONE )); then : > "$V/standalone"; else rm -f "$V/standalone"; fi   # метка: сервер сам следит за своим адресом (homeserv нет); при усыновлении снимается
activate
(( STANDALONE )) || "/usr/local/sbin/vampn" homeinit >/dev/null     # создаёт пира homeserv (адрес $NET.3); его конфиг homeserv заберёт командой `vampn homeconf`
verify
echo "VAMPN_PORT=$(awk -F' *= *' '/^ListenPort/{print $2; exit}' "$D/awg0.conf")"
echo "VAMPN_SERVER_PUBKEY=$(sed -n 's/^SERVER_PUBKEY=//p' "$V/server.env")"
echo "VAMPN_MAILRELAY_PUB=$(awk '{print $1, $2}' /root/.ssh/mailrelay.pub)"
echo "VAMPN_INSTALL_OK=1"
INSTALL_EOF
}
# <<< install.sh

relay_authorize() { # N СЕТЬ КЛЮЧ - разрешить почтовому ключу сервера ячейки N передавать письма через homeserv (прежняя строка ячейки заменяется)
  local n=$1 net=$2 pub=$3 ak=${HOME_AK:-/root/.ssh/authorized_keys} tmp
  [[ $pub =~ ^ssh-[a-z0-9-]+\ [A-Za-z0-9+/=]+ ]] || return 1
  pub=$(awk '{print $1, $2}' <<<"$pub")
  install -d -m 700 "$(dirname "$ak")"; touch "$ak"; tmp=$(mktemp)
  # прежнюю строку убираем только её саму (если она когда-то слиплась с соседней без перевода строки, соседняя остаётся)
  sed -E "s/restrict,from=\"[^\"]*\",command=\"[^\"]*\" ssh-[a-z0-9-]+ [A-Za-z0-9+\/=]+ vampn-mailrelay-$n\$//" "$ak" | awk 'NF' > "$tmp"
  echo "restrict,from=\"$net.1\",command=\"/usr/local/sbin/vampn mail\" $pub vampn-mailrelay-$n" >> "$tmp"
  cat "$tmp" > "$ak"; rm -f "$tmp"; chmod 600 "$ak"
}

mailkey_main() { # vampn mailkey N - прописать на homeserv ключ почты сервера ячейки N (лечит «relay failed ... Permission denied» при vampn resend/reissue)
  local n=${1:-} net ip pub="" h kh chk
  [[ $n =~ ^[0-9]+$ ]] && (( n >= 2 )) && [[ -f $CELLS_DIR/$n.env ]] || die "vampn mailkey N (N - номер ячейки 2 и выше, см. vampn cells)"
  net=$(cell_field "$n" CELL_NET); ip=$(cell_field "$n" CELL_IP); kh=$CELLS_DIR/$n.known_hosts_public
  for h in "$net.1" "$ip"; do
    [[ -n $h ]] || continue
    pub=$(ssh -T -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=2 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new \
          -o UserKnownHostsFile="$kh" -i "$ETC_DIR/spawn.key" "root@$h" 'cat /root/.ssh/mailrelay.pub' </dev/null 2>/dev/null) && [[ -n $pub ]] && break
    pub=""
  done
  [[ -n $pub ]] || die "не достучался до сервера ячейки $n (ни по туннелю $net.1, ни по $ip)"
  relay_authorize "$n" "$net" "$pub" || die "на сервере ячейки $n непонятный ключ почты"
  echo "ключ почты сервера ячейки $n прописан в ${HOME_AK:-/root/.ssh/authorized_keys}"
  chk=$(ssh -T -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=10 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="$kh" -i "$ETC_DIR/spawn.key" "root@$h" \
        "ssh -i /root/.ssh/mailrelay -p 777 -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/root/.ssh/mailrelay.known_hosts root@$net.3 true </dev/null 2>&1" </dev/null 2>&1) || true
  if grep -q 'Permission denied' <<<"$chk"; then echo "ВНИМАНИЕ: сервер всё равно не пускают: $(tail -c 200 <<<"$chk" | tr '\n' ' ')"; return 1; fi
  echo "проверка с сервера: вход на homeserv есть, письма пойдут через него"
}

# ---------- все ячейки сразу: с homeserv команды работают для пользователя любой ячейки ----------
cell_of_user() { # ИМЯ -> номер ячейки из users.conf (пусто, если пользователя там нет, например завели на самом сервере)
  sed 's/\r$//' "${VAMPN_USERS:-/etc/vampn/users.conf}" 2>/dev/null | awk -v n="$1" '
    /^[[:space:]]*#/ || NF == 0 { next }
    $1 == n { print (NF >= 3 && $3 ~ /^[0-9]+$/) ? $3 + 0 : 1; exit }'
}
cells_active() { # номера ячеек, готовых к работе: первая всегда, остальные - в состоянии «активна»
  local c; for c in $(cell_ids); do
    [[ $c == 1 || $(cell_field "$c" CELL_STATE) == активна ]] && echo "$c"
  done
}

list_all() { # vampn list на homeserv: пользователи ВСЕХ ячеек с пометкой ячейки
  local c t rc conf st total=0 bad="" fmt='%-20s %-7s %-15s %-30s %s\n'
  t=$(mktemp -d)
  for c in $(cells_active); do
    ( VAMPN_CELL=$c timeout "${LIST_TIMEOUT:-60}" "$SELF" list >"$t/$c.out" 2>"$t/$c.err" </dev/null; echo $? > "$t/$c.rc" ) &
  done
  wait
  printf "$fmt" ИМЯ ЯЧЕЙКА IP ПОЧТА "ПОСЛЕДНЕЕ ПОДКЛЮЧЕНИЕ"
  for c in $(cell_ids); do
    conf=$(sed 's/\r$//' "${VAMPN_USERS:-/etc/vampn/users.conf}" 2>/dev/null | awk -v c="$c" '
      /^[[:space:]]*#/ || NF < 2 { next }
      { cc = (NF >= 3 && $3 ~ /^[0-9]+$/) ? $3 + 0 : 1; if (cc == c) print $1, $2 }')
    rc=$(cat "$t/$c.rc" 2>/dev/null || echo skip)
    if [[ $rc == 0 ]]; then
      CONF="$conf" awk -v c="$c" -v fmt="$fmt" '
        BEGIN { m = split(ENVIRON["CONF"], L, "\n"); for (i = 1; i <= m; i++) { split(L[i], f, " "); if (f[1] != "") cm[f[1]] = f[2] } }
        NR > 1 && $1 != "" && $1 != "homeserv" {
          last = $4; for (i = 5; i <= NF; i++) last = last " " $i
          printf fmt, $1, c, $2, $3, last; seen[$1] = 1; n++
        }
        END { for (u in cm) if (!(u in seen)) { printf fmt, u, c, "-", cm[u], "ещё не создан на сервере"; n++ } ; print n + 0 > "/dev/stderr" }' "$t/$c.out" 2>"$t/$c.n"
      total=$(( total + $(tail -1 "$t/$c.n" 2>/dev/null || echo 0) ))
    else
      if [[ $rc == skip ]]; then st="ячейка не активна ($(cell_field "$c" CELL_STATE))"; else st="ячейка не отвечает"; fi
      [[ $rc == skip ]] || bad="$bad $c"
      while read -r u e; do
        [[ -n $u ]] || continue
        printf "$fmt" "$u" "$c" - "$e" "$st"; total=$(( total + 1 ))
      done <<<"$conf"
    fi
  done
  echo
  echo "Всего пользователей: $total, ячеек: $(cell_ids | wc -l)."
  [[ -z $bad ]] || echo "Не ответили (показаны по users.conf): ячейки${bad}. Подробности: VAMPN_CELL=N vampn list"
  echo "Команды reissue / resend / link / keyconf ИМЯ сами находят ячейку пользователя."
  rm -rf "$t"
}

user_route() { # reissue|resend|link|keyconf ИМЯ - выполнить в ячейке пользователя (сначала в той, что указана в users.conf, потом в остальных)
  local cmd=$1 n=${2:-} first c out rc ef err bad="" multi
  [[ $n =~ ^[a-zA-Z0-9_.-]{1,32}$ ]] || die "нужно имя пользователя: vampn $cmd ИМЯ"
  first=$(cell_of_user "$n")
  local -a order=(); [[ -n $first ]] && order+=("$first")
  for c in $(cells_active); do [[ $c == "$first" ]] || order+=("$c"); done
  multi=$(cell_ids | wc -l); ef=$(mktemp)
  for c in "${order[@]}"; do
    out=$(VAMPN_CELL=$c "$SELF" "$cmd" "$n" 2>"$ef"); rc=$?; err=$(cat "$ef")
    if (( rc == 0 )); then
      rm -f "$ef"; (( multi > 1 )) && echo "[ячейка $c]" >&2
      [[ -n $err ]] && echo "$err" >&2; [[ -n $out ]] && printf '%s\n' "$out"; return 0
    fi
    grep -qE 'нет пользователя|нет актуальной копии' <<<"$err$out" && continue     # его в этой ячейке нет - смотрим следующую
    if [[ $c == "$first" ]]; then
      rm -f "$ef"; [[ -n $out ]] && printf '%s\n' "$out"; echo "$err" >&2; die "ячейка $c (там пользователь $n): команда не выполнена"
    fi
    bad="$bad $c"
  done
  rm -f "$ef"
  [[ -z $bad ]] || die "пользователя $n нет в ответивших ячейках; не ответили:$bad"
  die "нет пользователя $n ни в одной ячейке (vampn list)"
}

all_cells() { # КОМАНДА [skipempty] - выполнить по очереди для каждой готовой ячейки
  local cmd=$1 c rc=0 n=0
  for c in $(cells_active); do
    [[ ${2:-} == skipempty ]] && (( $(cell_users "$c") == 0 )) && continue
    n=$(( n + 1 )); echo "== ячейка $c ($(cell_field "$c" CELL_NAME)) =="
    VAMPN_CELL=$c "$SELF" "$cmd" </dev/null || rc=1
  done
  (( n )) || echo "нет ячеек с пользователями"
  return $rc
}

home_main() {
  local cmd=${1:-}
  case $cmd in
    mail)       mailpy --relay; return ;;            # письма от VPN-сервера (принудительная команда ключа)
    alert)      mailpy --alert "${2:-vampn}"; return ;;
    resendall) if [[ -z ${VAMPN_CELL:-} ]]; then all_cells resendall skipempty; else resend_all; fi; return ;;
    mailstatus) mailstatus; return ;;
    mailkey)    mailkey_main "${2:-}"; return ;;
    keyconf)    if [[ -z ${VAMPN_CELL:-} ]]; then user_route keyconf "${2:-}"
                else key_local conf "${2:-}" || die "нет актуальной копии ключа ${2:-} (vampn mirror)"; fi; return ;;
    list)       if [[ -z ${VAMPN_CELL:-} ]]; then list_all; return; fi ;;
    reissue|resend|link) if [[ -z ${VAMPN_CELL:-} ]]; then user_route "$cmd" "${2:-}"; return; fi ;;
    users|mirror) if [[ -z ${VAMPN_CELL:-} ]]; then all_cells "$cmd"; return; fi ;;
    cells)      cells_main; return ;;
    account)    shift; account_main "$@"; return ;;
    spawn)      spawn_main "${2:-}"; return ;;
    adopt)      shift; adopt_main "$@"; return ;;
    rescue)     shift; rescue_main "$@"; return ;;
    spawnrun)     if [[ -n ${SPAWN_RESUME:-}${SPAWN_ADOPT:-} ]]; then spawn_run "${2:?кабинет}"; else spawn_loop "${2:?кабинет}"; fi; return ;;
    spawnresume) spawn_resume_main "${2:-}"; return ;;
    spawnstatus) spawn_status "${2:-}"; return ;;
    celldel)   shift; cell_del "$@"; return ;;
    installscript) install_sh; return ;;     # установочный бандл для чистого Debian (его же отдаёт spawn)
  esac
  tw_init
  case $cmd in
    check)  check; mail_watch ;;
    status) status ;;
    peers)  home_peers ;;
    deploy) deploy_scripts force; echo "скрипт отправлен на Бостон и активный VPN-сервер (результат в журнале: vampn status)" ;;
    rotate) shift; rotate "$@" ;;
    reboot) do_reboot "${2:-}" ;;
    use)    [[ ${2:-} =~ ^[12]$ ]] || die "vampn use 1|2 (1 - основной сервер Timeweb, 2 - запасной)"
            tw_use "$2" || die "для сервера $2 нет файла доступа"; put active_target "$2"; put users_pushed none; put last_mirror 0
            cur=$(main_ipv4); [[ -n $cur ]] && tun_set_endpoint "$cur"; echo "активный сервер: $(tw_label), туннель: $(tun_endpoint)" ;;
    sync)   cur=$(main_ipv4); [[ -n $cur ]] && tun_set_endpoint "$cur"; echo "сервер: $(tun_endpoint)" ;;
    mirror) pull_mirror && echo "ok: $(ls "$MIRROR"/clients/*.env | wc -l) пользователей" ;;
    users)  push_users force ;;
    emergency)
      (( CELL > 1 )) && die "аварийный канал (Бостон) есть только у ячейки 1"
      case ${2:-status} in
        on)     emergency_on "${3:-}" ;;
        off)    emergency_off "${3:-}" ;;
        status) emergency_status ;;
        *)      die "vampn emergency on|off|status" ;;
      esac ;;
    list|server|snapshot|reissue|resend|link)
      em_active && die "сейчас аварийный режим: основной сервер недоступен, эта команда работает с ним"
      home_remote "$@" ;;
    *) echo "vampn: неизвестная команда «$cmd»" >&2; usage 1 ;;
  esac
}

# Только чтение, для статистики в приложении. Строка на ключ, поля через табуляцию:
# СЕРВЕР (основной|запасной|аварийный), IP сервера, ИМЯ, IP клиента (или -), рукопожатие (unix, 0 - не было), принято, отправлено (байт).
# В аварийном режиме спрашивает аварийный сервер, иначе активный VPN-сервер.
home_peers() {
  local label ip out
  if em_active; then
    em_init; label=аварийный; ip=$EM_HOST
    out=$(em_ssh peers </dev/null) || die "аварийный сервер не ответил"
  else
    label=$(tw_label); ip=$(tun_endpoint)
    out=$(remote peers) || die "VPN-сервер не ответил"
  fi
  awk -F'\t' -v OFS='\t' -v l="$label" -v s="${ip:--}" 'NF==5 {print l, s, $1, $2, $3, $4, $5}' <<<"$out"
}

home_remote() {
  local cmd=$1
  case $cmd in
    list)   remote list ;;
    server) remote status ;;
    snapshot) remote snapshot ;;
    link)   [[ ${2:-} =~ ^[a-zA-Z0-9_.-]{1,32}$ ]] || die "нужно имя пользователя: vampn link ИМЯ"
            key_local link "$2" || remote "link $2" ;;
    reissue|resend)
      [[ ${2:-} =~ ^[a-zA-Z0-9_.-]{1,32}$ ]] || die "нужно имя пользователя: vampn $cmd ИМЯ"
      remote "$cmd $2"
      [[ $cmd == reissue ]] && { pull_mirror >/dev/null 2>&1 || true; } ;;
    *) echo "vampn: неизвестная команда «$cmd»" >&2; usage 1 ;;
  esac
}

usage() { awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$SELF"; exit "${1:-0}"; }

init_main() { # vampn init [--user ИМЯ] [--net 10.77.4] [--port N] [--public-ip IP] [--name ИМЯ_СЕРВЕРА] [--packages-only]
  # На ЧИСТОМ Debian 13 из клона репозитория: ставит пакеты, AmneziaWG, файрвол, самолечение и поднимает рабочую ячейку
  # (сервер без homeserv); в конце печатает конфиг, QR и ссылку первого пользователя. Повторный запуск ничего не ломает.
  [[ $EUID == 0 ]] || die "vampn init: нужен root"
  local user=client1 net=10.77.4 port="" pub="" name="" pk=0 src dir pay out
  while (( $# )); do
    case $1 in
      --user) user=${2:?имя}; shift 2 ;;     --net) net=${2:?сеть}; shift 2 ;;       --port) port=${2:?порт}; shift 2 ;;
      --public-ip) pub=${2:?IP}; shift 2 ;;  --name) name=${2:?имя}; shift 2 ;;      --packages-only) pk=1; shift ;;
      *) die "vampn init: неизвестный параметр $1 (есть --user --net --port --public-ip --name --packages-only)" ;;
    esac
  done
  if (( pk )); then install_sh | bash -s -- --packages-only; return; fi
  valid_name "$user"
  src=$(readlink -f "$0"); dir=$(dirname "$src")
  pay=$(mktemp -d); chmod 700 "$pay"; cp "$src" "$pay/vampn"
  [[ -f $dir/amnezia.gpg ]] && cp "$dir/amnezia.gpg" "$pay/amnezia.gpg"
  if [[ -z $pub ]]; then pub=$(detect_public_ip) || { echo "vampn init: внешний IP не определился, укажите --public-ip IP" >&2; rm -rf "$pay"; exit 1; }; fi
  echo "[init] внешний адрес сервера: $pub, сеть VPN: $net.0/22" >&2
  out=$(install_sh | bash -s -- --standalone --payload "$pay" --net "$net" --span 4 --public-ip "$pub" ${port:+--port "$port"} ${name:+--name "$name"}) \
    || { local rc=$?; rm -rf "$pay"; echo "$out" >&2; exit "$rc"; }
  rm -rf "$pay"
  echo "$out" | grep -E '^VAMPN_(PORT|SERVER_PUBKEY)=' >&2 || true
  if ! ls /root/vampn/clients/*.env >/dev/null 2>&1; then
    VAMPN_BASE=/root/vampn /usr/local/sbin/vampn add "$user"
  else
    echo "[init] пользователи уже есть: vampn list; новый - vampn add ИМЯ" >&2
  fi
  if [[ -s $dir/homeserv.pub ]]; then
    install -d -m 700 /root/.ssh
    grep -qF "$(awk '{print $2}' "$dir/homeserv.pub" | head -1)" /root/.ssh/authorized_keys 2>/dev/null \
      || awk 'NF>=2 {print $1, $2, "homeserv"}' "$dir/homeserv.pub" | head -1 >> /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
  fi
  echo "[init] готово: сервер vampn работает. Команды: vampn add ИМЯ, vampn list, vampn conf ИМЯ, vampn qr ИМЯ, vampn link ИМЯ, vampn del ИМЯ, vampn status" >&2
  echo "[init] чтобы подключить сервер к системе (ячейка, перенос отвалившихся, новые ключи), на homeserv: vampn adopt $pub" >&2
}

selfupdate_main() { # stdin: новый скрипт vampn от homeserv; ставится, только если он целый, старый остаётся как .prev
  local dst=${VAMPN_INSTALL:-$SELF} tmp
  tmp=$(mktemp "$(dirname "$dst")/.vampn-new.XXXXXX") || die "не могу создать временный файл"
  head -c 3000000 > "$tmp"
  if ! head -1 "$tmp" | grep -q '^#!/bin/bash' || ! grep -q '^SELF=/usr/local/sbin/vampn$' "$tmp"; then
    rm -f "$tmp"; die "это не скрипт vampn, не ставлю"
  fi
  bash -n "$tmp" 2>/dev/null || { rm -f "$tmp"; die "в новом скрипте ошибка синтаксиса, не ставлю"; }
  chmod 755 "$tmp"
  "$tmp" help >/dev/null 2>&1 || { rm -f "$tmp"; die "новый скрипт не запускается, не ставлю"; }
  [[ -f $dst ]] && cp -p "$dst" "$dst.prev"
  mv -f "$tmp" "$dst"
  logger -t vampn "скрипт обновлён с homeserv: $(sha256sum "$dst" | cut -c1-16)" 2>/dev/null || true
  echo "ok $(sha256sum "$dst" | cut -c1-16)"
}

# ====================================================================================================
# Общие команды (на любом сервере) и разбор
# ====================================================================================================
case ${1:-} in
  conf)  data_init; valid_name "${2:-}"; render "$2"; cat "$CL/$2.conf"; exit ;;
  qr)    data_init; valid_name "${2:-}"; render "$2"; qrencode -t ansiutf8 < "$CL/$2.conf"; exit ;;
  mailtest) [[ -n ${2:-} ]] || die "vampn mailtest АДРЕС"; mailpy --test "$2"; exit ;;
  mailsend) shift; mailpy "$@"; exit ;;
  endpointchange) data_init; endpoint_change "${2:?IP}"; exit ;;
  selfupdate) selfupdate_main; exit ;;
  init) shift; init_main "$@"; exit ;;   # на новом чистом сервере: развернуть проект целиком и выдать готовую ячейку
  help|-h|--help) usage 0 ;;
  '') usage 1 ;;
esac
case $ROLE in
  server)    server_main "$@" ;;
  emergency) emergency_main "$@" ;;
  *)         home_main "$@" ;;
esac
