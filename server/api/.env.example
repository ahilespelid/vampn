# Пример настроек API. Настоящий файл (/etc/vampn-api/api.env, root:vampn 640) в git не кладётся.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=vampn
DB_PASSWORD=
DB_NAME=vampn
# случайная строка 32+ символов: перец для хешей кодов входа
API_SECRET=
# почта для кодов входа (те же настройки, что в /etc/vampn/secrets.env на homeserv)
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
VAMPN_BIN=/usr/local/sbin/vampn
