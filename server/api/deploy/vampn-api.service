# /etc/systemd/system/vampn-api.service (так стоит на homeserv)
# Адрес 172.28.0.1 - шлюз docker-сети litewms_net: Caddy работает в Docker и достаёт до API по нему,
# снаружи порт не виден. Проверить шлюз: docker network inspect litewms_net
[Unit]
Description=vampn API (FastAPI)
After=network-online.target docker.service
Wants=docker.service
StartLimitIntervalSec=0

[Service]
User=vampn
Group=vampn
WorkingDirectory=/var/www/vampn/api
EnvironmentFile=/etc/vampn-api/api.env
ExecStart=/var/www/vampn/api/.venv/bin/uvicorn vampn_api.asgi:app --host 172.28.0.1 --port 8741 --no-proxy-headers
Restart=always
RestartSec=5
# sudo для команд vampn требует setuid, поэтому NoNewPrivileges не включается
NoNewPrivileges=false
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
